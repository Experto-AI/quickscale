name: CI

on:
  push:
    branches: [ main, develop ]
  pull_request:
    branches: [ main, develop ]

permissions:
  contents: read

jobs:
  test:
    runs-on: ubuntu-24.04
    services:
      postgres:
        image: postgres:{{ postgres_patch_version }}
        env:
          POSTGRES_HOST_AUTH_METHOD: trust
        options: >-
          --health-cmd pg_isready
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5
        ports:
          - 5432:5432
    strategy:
      matrix:
        python-version: ["{{ python_patch_version }}"]
        django-version: ["{{ django_ci_version }}"]

    steps:
    - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1

    # Non-live module credentials live in the managed .github/quickscale-ci-env
    # file, so this user-owned workflow names no module value and a module
    # release changes no user-owned file. A project using a custom *_env_var
    # name sets it in quickscale.yml and re-runs `quickscale apply`.
    - name: Load module CI environment
      run: cat .github/quickscale-ci-env >> "$GITHUB_ENV"

    - name: Set up Python {% raw %}${{ matrix.python-version }}{% endraw %}
      uses: actions/setup-python@6d4fd22b20465ccc0f7354476588e8df7c9ca0e0 # v7.1.0
      with:
        python-version: {% raw %}${{ matrix.python-version }}{% endraw %}

    - name: Install PostgreSQL {{ postgres_version }} client tooling
      run: |
        sudo apt-get update
        sudo apt-get install -y ca-certificates curl
        distro_codename="$(
          . /etc/os-release
          echo "$VERSION_CODENAME"
        )"
        sudo install -d /usr/share/postgresql-common/pgdg
        sudo curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc \
          -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc
        echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] http://apt.postgresql.org/pub/repos/apt ${distro_codename}-pgdg main" \
          | sudo tee /etc/apt/sources.list.d/pgdg.list > /dev/null
        sudo apt-get update
        sudo apt-get install -y postgresql-client-{{ postgres_version }}
        echo "/usr/lib/postgresql/{{ postgres_version }}/bin" >> "$GITHUB_PATH"

    - name: Verify PostgreSQL {{ postgres_version }} client tooling
      run: |
        test -x /usr/lib/postgresql/{{ postgres_version }}/bin/pg_dump
        test -x /usr/lib/postgresql/{{ postgres_version }}/bin/pg_restore
        test "$(command -v pg_dump)" = "/usr/lib/postgresql/{{ postgres_version }}/bin/pg_dump"
        test "$(command -v pg_restore)" = "/usr/lib/postgresql/{{ postgres_version }}/bin/pg_restore"
        /usr/lib/postgresql/{{ postgres_version }}/bin/pg_dump --version | grep -F "(PostgreSQL) {{ postgres_version }}"
        /usr/lib/postgresql/{{ postgres_version }}/bin/pg_restore --version | grep -F "(PostgreSQL) {{ postgres_version }}"

    - name: Install Poetry
      uses: snok/install-poetry@a783c322200f0519c7926aa6faa857c4e23e9263 # v1.4.2
      with:
        virtualenvs-create: true
        virtualenvs-in-project: true

    - name: Load cached venv
      id: cached-poetry-dependencies
      uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
      with:
        path: .venv
        key: venv-{% raw %}${{ runner.os }}-${{ matrix.python-version }}-${{ hashFiles('**/poetry.lock') }}{% endraw %}

    - name: Install dependencies
      if: steps.cached-poetry-dependencies.outputs.cache-hit != 'true'
      run: poetry install --no-interaction --no-root

    - name: Install project
      run: poetry install --no-interaction

    - name: Install Django {% raw %}${{ matrix.django-version }}{% endraw %}
      run: poetry add "Django~={% raw %}${{ matrix.django-version }}{% endraw %}" --group dev

    - name: Run ruff format check
      run: poetry run ruff format --check .

    - name: Run ruff linter
      run: poetry run ruff check .

    - name: Run tests with coverage
      run: poetry run pytest --cov={{ package_name }} --cov-report=xml --cov-report=term-missing
      env:
        DATABASE_URL: postgres://postgres@localhost/postgres
        # QuickScale module CI environment (managed)
{{ module_ci_test_env | default("") | indent(8, true) }}        # End QuickScale module CI environment

    - name: Upload coverage to Codecov
      uses: codecov/codecov-action@303a32d7a59b442fa8d48b6a1cc6825c09c847a5 # v7.1.1
      if: matrix.python-version == '{{ python_patch_version }}' && matrix.django-version == '{{ django_ci_version }}'
      with:
        files: ./coverage.xml
        fail_ci_if_error: false

    # QuickScale module CI steps (managed)
{{ module_ci_steps | default("") | indent(4, true) }}    # End QuickScale module CI steps

  frontend-lint:
    runs-on: ubuntu-latest
    # A job-level hashFiles() guard is rejected by GitHub before any job starts:
    # every showcase_react generation emits frontend/package.json, so this job runs.
    steps:
    - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1

    - name: Set up Node.js
      uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
      with:
        node-version: '24.22.1'

    - name: Install pnpm
      uses: pnpm/action-setup@ea17c68df8912ef543352723c149a84f56e3d413 # v6.1.0
      with:
        version: 11.18.0

    - name: Get pnpm store directory
      shell: bash
      run: echo "STORE_PATH=$(pnpm store path --silent)" >> "$GITHUB_ENV"

    - name: Setup pnpm cache
      uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
      with:
        path: {% raw %}${{ env.STORE_PATH }}{% endraw %}
        key: {% raw %}${{ runner.os }}-pnpm-store-${{ hashFiles('frontend/pnpm-lock.yaml') }}{% endraw %}
        restore-keys: |
          {% raw %}${{ runner.os }}-pnpm-store-{% endraw %}

    - name: Install frontend dependencies
      working-directory: frontend
      run: pnpm install

    - name: Run ESLint
      working-directory: frontend
      run: pnpm lint

    - name: Run TypeScript type check
      working-directory: frontend
      run: pnpm type-check

    - name: Run frontend tests
      working-directory: frontend
      run: pnpm test:coverage

  # QuickScale module CI jobs (managed)
{{ module_ci_jobs | default("") | indent(2, true) }}  # End QuickScale module CI jobs
