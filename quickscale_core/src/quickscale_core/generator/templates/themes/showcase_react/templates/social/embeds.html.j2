{%raw%}{% extends "base.html" %}

{% load static %}

{% block title %}Social Embeds | {% endraw %}{{ project_name }}{% raw %}{% endblock %}

{% block extra_css %}
<style>
    .qs-main {
        max-width: 1200px;
        padding-top: 1.75rem;
        padding-bottom: 2.5rem;
    }
    .qs-social-react-shell {
        min-height: 70vh;
    }
    .qs-social-react-shell:empty::before {
        content: 'Loading public embed gallery...';
        display: block;
        width: 100%;
        padding: 1rem 1.25rem;
        border: 1px solid #cbd5e1;
        border-radius: 1rem;
        background: linear-gradient(135deg, #ffffff 0%, #eef2ff 100%);
        color: #475569;
        font-weight: 600;
    }
</style>
{% endblock %}

{% block content %}
{% if 'quickscale_modules_social' in settings.INSTALLED_APPS and settings.QUICKSCALE_SOCIAL_ENABLED %}
<div id="root" class="qs-social-react-shell"></div>
<noscript>
    <div class="qs-alert qs-alert-info">
        JavaScript is required to render the managed public embed gallery on this page.
    </div>
</noscript>
{% else %}
<section class="qs-card">
  <h1>Social module not active</h1>
  <p>
    This theme reserves <code>/social/embeds</code>, but the managed public embed gallery only
    hydrates when the social module is installed and its <code>QUICKSCALE_SOCIAL_ENABLED</code>
    setting is on.
  </p>
</section>
{% endif %}
{% endblock %}{% endraw %}

{% raw %}{% block extra_js %}
{% if 'quickscale_modules_social' in settings.INSTALLED_APPS and settings.QUICKSCALE_SOCIAL_ENABLED %}
<script>
  window.__QUICKSCALE__ = {
    projectName: "{% endraw %}{{ project_name }}{% raw %}",
    modules: {
{%endraw%}{{ seam_module_flags }}{%raw%}
    },
    modulePaths: {
{%endraw%}{{ seam_module_paths }}{%raw%}
    },
    owner: {
      mode: "solo",
      currentOrgSlug: null,
    },
    publicPage: {
      module: 'social',
      surface: 'embeds',
      endpoint: "{{ settings.QUICKSCALE_SOCIAL_INTEGRATION_EMBEDS_PATH }}",
      navigation: {
        home: '/',
        linkTree: "{{ settings.QUICKSCALE_SOCIAL_LINK_TREE_PATH }}",
        embeds: "{{ settings.QUICKSCALE_SOCIAL_EMBEDS_PATH }}",
      },
    },
  }
</script>
<script type="module" src="{% static 'frontend/assets/index.js' %}"></script>
{% endif %}
{% endblock %}{% endraw %}
