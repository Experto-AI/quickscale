{%raw%}{% load static %}<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{% block title %}{%endraw%}{{ project_name }}{%raw%}{% endblock %}</title>
    <link rel="icon" type="image/svg+xml" href="{% static 'frontend/favicon.svg' %}" />
    <script>
        (() => {
            let theme = "light";
            try {
                const stored = JSON.parse(localStorage.getItem("theme-storage") || "{}");
                if (stored?.state?.theme === "dark") {
                    theme = "dark";
                }
            } catch (error) {
                console.warn("QuickScale theme preference could not be restored.", error);
            }
            document.documentElement.classList.remove("light", "dark");
            document.documentElement.classList.add(theme);
        })();
    </script>
    {% if settings.DEBUG %}
    <link rel="stylesheet" href="{{ settings.QUICKSCALE_FRONTEND_ORIGIN|default:'http://localhost:5173' }}/static/frontend/src/index.css" />
    {% else %}
    <link rel="stylesheet" href="{% static 'frontend/assets/index.css' %}" />
    {% endif %}
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: ui-sans-serif, system-ui, sans-serif;
            line-height: 1.6;
            color: hsl(var(--foreground));
            background: hsl(var(--background));
            min-height: 100vh;
        }
        button, input, select, textarea { font: inherit; }
        a { color: hsl(var(--primary)); text-decoration: none; }
        a:hover { text-decoration: underline; }
        .qs-topbar {
            background: hsl(var(--card));
            border-bottom: 1px solid hsl(var(--border));
            padding: 0.75rem 1.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            flex-wrap: wrap;
        }
        .qs-topbar-brand {
            font-weight: 600;
            font-size: 1.125rem;
            color: hsl(var(--foreground));
        }
        .qs-topbar-nav {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            flex-wrap: wrap;
        }
        .qs-topbar-link {
            font-size: 0.875rem;
            color: hsl(var(--muted-foreground));
            padding: 0.4rem 0.75rem;
            border-radius: var(--radius);
        }
        .qs-topbar-link:hover {
            color: hsl(var(--accent-foreground));
            background: hsl(var(--accent));
            text-decoration: none;
        }
        .qs-main { max-width: 1120px; margin: 0 auto; padding: 2.5rem 1.5rem; }
        .qs-messages { margin-bottom: 1.5rem; }
        .qs-alert {
            padding: 0.75rem 1rem;
            border-radius: var(--radius);
            margin-bottom: 0.5rem;
            font-size: 0.875rem;
        }
        .qs-alert-success, .qs-alert-info {
            background: hsl(var(--secondary));
            color: hsl(var(--secondary-foreground));
            border: 1px solid hsl(var(--border));
        }
        .qs-alert-error, .qs-alert-danger {
            background: hsl(var(--destructive) / 0.12);
            color: hsl(var(--destructive));
            border: 1px solid hsl(var(--destructive) / 0.35);
        }
        .qs-alert-warning {
            background: hsl(var(--accent));
            color: hsl(var(--accent-foreground));
            border: 1px solid hsl(var(--border));
        }
        .qs-footer {
            text-align: center;
            padding: 1.5rem;
            color: hsl(var(--muted-foreground));
            font-size: 0.8rem;
            border-top: 1px solid hsl(var(--border));
            margin-top: 3rem;
        }
    </style>
    {% block extra_css %}{% endblock %}
</head>
<body>
    <nav class="qs-topbar">
        <a href="/" class="qs-topbar-brand">{%endraw%}{{ project_name }}{%raw%}</a>
        <div class="qs-topbar-nav">
            <a href="/" class="qs-topbar-link">App</a>
            {% if 'quickscale_modules_social' in settings.INSTALLED_APPS and settings.QUICKSCALE_SOCIAL_ENABLED and settings.QUICKSCALE_SOCIAL_LINK_TREE_ENABLED %}
            <a href="/social" class="qs-topbar-link">Social</a>
            {% endif %}
            {% if 'quickscale_modules_social' in settings.INSTALLED_APPS and settings.QUICKSCALE_SOCIAL_ENABLED and settings.QUICKSCALE_SOCIAL_EMBEDS_ENABLED %}
            <a href="/social/embeds" class="qs-topbar-link">Embeds</a>
            {% endif %}
        </div>
    </nav>

    <main class="qs-main">
        {% if messages %}
        <div class="qs-messages">
            {% for message in messages %}
            <div class="qs-alert qs-alert-{{ message.tags }}">{{ message }}</div>
            {% endfor %}
        </div>
        {% endif %}

        {% block content %}{% endblock %}
    </main>

    <footer class="qs-footer">
        &copy; {% now "Y" %} {%endraw%}{{ project_name }}{%raw%}. Built with QuickScale.
    </footer>

    {% block extra_js %}{% endblock %}
</body>
</html>{%endraw%}
