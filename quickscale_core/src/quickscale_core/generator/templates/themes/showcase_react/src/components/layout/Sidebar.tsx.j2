{% raw -%}
import { NavLink } from 'react-router-dom'
import {
  Building2,
  Home,
  Settings,
  BookOpen,
  CreditCard,
  Store,
  Briefcase,
  UserCircle,
  ClipboardList,
  Share2,
  Users,
} from 'lucide-react'
import { cn } from '@/lib/utils'
import { Separator } from '@/components/ui/separator'
import { OrgSwitcher } from '@/components/orgs/OrgSwitcher'
import { buildOrgPath, useProjectConfig } from '@/hooks/useModules'
import { useOrgNavigation } from '@/hooks/useOrgNavigation'
import { useOrg } from '@/hooks/useOrgs'

interface NavItem {
  name: string
  href: string
  icon: React.ComponentType<{ className?: string }>
  show: boolean
  end?: boolean
  reloadDocument?: boolean
}

export function Sidebar() {
  const { modules, modulePaths } = useProjectConfig()
  const { appPaths, currentOrgSlug, hasOrgContext, isSaas } = useOrgNavigation()
  const orgQuery = useOrg(currentOrgSlug ?? '')
  const billingPath = isSaas && currentOrgSlug
    ? buildOrgPath(
        currentOrgSlug,
        orgQuery.data?.actor.is_owner_like ? 'billing/dashboard/' : 'billing/pricing/',
      )
    : modulePaths.billing

  const navigation: NavItem[] = [
    { name: 'Organizations', href: appPaths.orgList, icon: Building2, show: isSaas, end: true },
    { name: 'Dashboard', href: appPaths.dashboard, icon: Home, show: true, end: true },
    { name: 'Blog', href: appPaths.blog, icon: BookOpen, show: modules.blog && (!isSaas || hasOrgContext) },
    {
      name: 'Listings',
      href: appPaths.listings,
      icon: Store,
      show: modules.listings && (!isSaas || hasOrgContext),
    },
    { name: 'CRM', href: appPaths.crm, icon: Briefcase, show: modules.crm && (!isSaas || hasOrgContext) },
    {
      name: 'Forms',
      href: appPaths.forms,
      icon: ClipboardList,
      show: modules.forms && (!isSaas || hasOrgContext),
    },
    { name: 'Members', href: appPaths.members, icon: Users, show: isSaas && hasOrgContext },
    {
      name: 'Billing',
      href: billingPath,
      icon: CreditCard,
      show: modules.billing && (!isSaas || hasOrgContext),
      reloadDocument: true,
    },
    {
      name: 'Social',
      href: modulePaths.social,
      icon: Share2,
      show: modules.social,
      reloadDocument: true,
    },
  ]

  const bottomNavigation: NavItem[] = [
    { name: 'Auth', href: '/profile', icon: UserCircle, show: modules.auth },
    {
      name: isSaas ? 'Org Settings' : 'Settings',
      href: appPaths.settings,
      icon: Settings,
      show: !isSaas || hasOrgContext,
    },
  ]

  return (
    <aside className="hidden min-h-screen w-64 flex-col border-r bg-sidebar lg:flex">
      <div className="p-6 pb-4">
        <h1 className="text-xl font-bold text-sidebar-foreground">{% endraw %}{{ project_name }}{% raw %}</h1>
      </div>
      {isSaas && <div className="px-4 pb-4"><OrgSwitcher /></div>}
      <Separator />
      <nav className="flex-1 space-y-1 p-4">
        {navigation
          .filter((item) => item.show)
          .map((item) => (
            <NavLink
              key={item.name}
              to={item.href}
              end={item.end}
              reloadDocument={item.reloadDocument}
              className={({ isActive }) =>
                cn(
                  'flex items-center gap-3 rounded-lg px-3 py-2 text-sm transition-colors',
                  isActive
                    ? 'bg-sidebar-accent text-sidebar-accent-foreground'
                    : 'text-sidebar-foreground hover:bg-sidebar-accent hover:text-sidebar-accent-foreground',
                )
              }
            >
              <item.icon className="h-4 w-4" />
              {item.name}
            </NavLink>
          ))}
      </nav>
      <Separator />
      <div className="space-y-1 p-4">
        {bottomNavigation
          .filter((item) => item.show)
          .map((item) => (
            <NavLink
              key={item.name}
              to={item.href}
              reloadDocument={item.reloadDocument}
              className={({ isActive }) =>
                cn(
                  'flex items-center gap-3 rounded-lg px-3 py-2 text-sm transition-colors',
                  isActive
                    ? 'bg-sidebar-accent text-sidebar-accent-foreground'
                    : 'text-sidebar-foreground hover:bg-sidebar-accent hover:text-sidebar-accent-foreground',
                )
              }
            >
              <item.icon className="h-4 w-4" />
              {item.name}
            </NavLink>
          ))}
      </div>
    </aside>
  )
}
{% endraw -%}
