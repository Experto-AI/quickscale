{% raw -%}
import { useEffect, useState } from 'react'
import { ShieldAlert, UserPlus, UserX } from 'lucide-react'
import { Badge } from '@/components/ui/badge'
import { Button } from '@/components/ui/button'
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card'
import { Input } from '@/components/ui/input'
import { Label } from '@/components/ui/label'
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from '@/components/ui/select'
import { OrgStatePanel } from '@/components/orgs/OrgStatePanel'
import { getApiErrorMessage, getApiFieldErrors } from '@/hooks/useApi'
import { useOrgNavigation } from '@/hooks/useOrgNavigation'
import {
  isOrgAdminLike,
  type OrgMember,
  type OrgRole,
  type OrgRoleChoice,
  useInviteOrgMember,
  useOrgMembers,
  useRemoveOrgMember,
  useRevokeOrgInvitation,
  useUpdateOrgMemberRole,
} from '@/hooks/useOrgs'
import { useOrgPageContext } from './OrgLayout'

function buildRoleChoices(member: OrgMember, choices: OrgRoleChoice[]): OrgRoleChoice[] {
  if (choices.some((choice) => choice.value === member.role)) {
    return choices
  }

  return [{ value: member.role, label: member.role_label }, ...choices]
}

export function OrgMembersPage() {
  const { actor, organization } = useOrgPageContext()
  const { appPaths, currentOrgSlug } = useOrgNavigation()
  const membersQuery = useOrgMembers(currentOrgSlug ?? '')
  const inviteMutation = useInviteOrgMember(currentOrgSlug ?? '')
  const updateRoleMutation = useUpdateOrgMemberRole(currentOrgSlug ?? '')
  const removeMemberMutation = useRemoveOrgMember(currentOrgSlug ?? '')
  const revokeInvitationMutation = useRevokeOrgInvitation(currentOrgSlug ?? '')
  const [inviteEmail, setInviteEmail] = useState('')
  const [inviteRole, setInviteRole] = useState<OrgRole>('member')
  const [pageError, setPageError] = useState<string | null>(null)
  const canManageMembers = isOrgAdminLike(actor)

  useEffect(() => {
    const firstRoleChoice = membersQuery.data?.role_choices?.[0]?.value
    if (firstRoleChoice) {
      setInviteRole(firstRoleChoice)
    }
  }, [membersQuery.data?.role_choices])

  if (!canManageMembers) {
    return (
      <OrgStatePanel
        actionHref={appPaths.dashboard}
        actionLabel="Back to organization"
        description="Only organization admins and owners can view or change the members roster."
        icon={ShieldAlert}
        title="Members access restricted"
      />
    )
  }

  if (membersQuery.isError) {
    return (
      <OrgStatePanel
        actionHref={appPaths.dashboard}
        actionLabel="Back to organization"
        description={getApiErrorMessage(
          membersQuery.error,
          'The members roster could not be loaded.',
        )}
        icon={ShieldAlert}
        title="Unable to load members"
      />
    )
  }

  if (membersQuery.isLoading || !membersQuery.data) {
    return (
      <div className="grid gap-4 lg:grid-cols-[minmax(0,320px)_1fr]">
        <Card className="animate-pulse">
          <CardHeader>
            <div className="h-5 w-32 rounded bg-muted" />
            <div className="h-4 w-48 rounded bg-muted" />
          </CardHeader>
          <CardContent>
            <div className="h-10 w-full rounded bg-muted" />
          </CardContent>
        </Card>
        <Card className="animate-pulse">
          <CardHeader>
            <div className="h-5 w-48 rounded bg-muted" />
            <div className="h-4 w-56 rounded bg-muted" />
          </CardHeader>
          <CardContent>
            <div className="h-24 w-full rounded bg-muted" />
          </CardContent>
        </Card>
      </div>
    )
  }

  const inviteFieldErrors = getApiFieldErrors(inviteMutation.error)
  const members = membersQuery.data.members
  const ownerCount = members.filter((member) => member.role === 'owner').length
  const pendingInvitations = membersQuery.data.pending_invitations
  const roleChoices = membersQuery.data.role_choices

  async function handleInvite(event: React.FormEvent<HTMLFormElement>) {
    event.preventDefault()
    setPageError(null)

    try {
      await inviteMutation.mutateAsync({ email: inviteEmail, role: inviteRole })
      setInviteEmail('')
    } catch (error) {
      const errors = getApiFieldErrors(error)
      if (!errors.email?.length) {
        setPageError(getApiErrorMessage(error))
      }
    }
  }

  async function handleRoleChange(member: OrgMember, role: OrgRole) {
    if (member.role === role) {
      return
    }

    setPageError(null)

    try {
      await updateRoleMutation.mutateAsync({ membershipId: member.id, role })
    } catch (error) {
      setPageError(getApiErrorMessage(error))
    }
  }

  async function handleRemoveMember(member: OrgMember) {
    setPageError(null)

    try {
      await removeMemberMutation.mutateAsync({ membershipId: member.id })
    } catch (error) {
      setPageError(getApiErrorMessage(error))
    }
  }

  async function handleRevokeInvitation(invitationId: string) {
    setPageError(null)

    try {
      await revokeInvitationMutation.mutateAsync({ invitationId })
    } catch (error) {
      setPageError(getApiErrorMessage(error))
    }
  }

  return (
    <div className="grid gap-6 xl:grid-cols-[minmax(0,360px)_1fr]">
      <Card className="h-fit">
        <CardHeader>
          <CardTitle>Invite member</CardTitle>
          <CardDescription>
            Send an invitation to join {organization.name}. Owner invites stay excluded until
            ownership transfer ships.
          </CardDescription>
        </CardHeader>
        <CardContent>
          <form onSubmit={handleInvite} className="space-y-4">
            <div className="space-y-2">
              <Label htmlFor="invite-email">Email</Label>
              <Input
                id="invite-email"
                type="email"
                value={inviteEmail}
                onChange={(event) => {
                  setInviteEmail(event.target.value)
                  setPageError(null)
                }}
                placeholder="teammate@example.com"
              />
              {inviteFieldErrors.email?.[0] && (
                <p className="text-sm text-destructive">{inviteFieldErrors.email[0]}</p>
              )}
            </div>

            <div className="space-y-2">
              <Label htmlFor="invite-role">Role</Label>
              <Select value={inviteRole} onValueChange={(value: OrgRole) => setInviteRole(value)}>
                <SelectTrigger id="invite-role">
                  <SelectValue placeholder="Choose a role" />
                </SelectTrigger>
                <SelectContent>
                  {roleChoices.map((choice) => (
                    <SelectItem key={choice.value} value={choice.value}>
                      {choice.label}
                    </SelectItem>
                  ))}
                </SelectContent>
              </Select>
            </div>

            {inviteFieldErrors.non_field_errors?.[0] && (
              <p className="text-sm text-destructive">{inviteFieldErrors.non_field_errors[0]}</p>
            )}

            <Button
              type="submit"
              disabled={inviteMutation.isPending || !inviteEmail.trim()}
              className="w-full"
            >
              <UserPlus className="mr-2 h-4 w-4" />
              {inviteMutation.isPending ? 'Sending invite...' : 'Send invitation'}
            </Button>
          </form>
        </CardContent>
      </Card>

      <div className="space-y-6">
        {pageError && (
          <div className="rounded-md border border-destructive/40 bg-destructive/10 px-4 py-3 text-sm text-destructive">
            {pageError}
          </div>
        )}

        <Card>
          <CardHeader>
            <CardTitle>Members</CardTitle>
            <CardDescription>
              Change roles, remove members, and protect the final owner from destructive edits.
            </CardDescription>
          </CardHeader>
          <CardContent className="space-y-4">
            {members.map((member) => {
              const isLastOwner = member.role === 'owner' && ownerCount <= 1
              const memberRoleChoices = buildRoleChoices(member, roleChoices)

              return (
                <div key={member.id} className="rounded-lg border p-4">
                  <div className="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
                    <div>
                      <div className="flex items-center gap-2">
                        <p className="font-medium">
                          {member.user.display_name || member.user.username}
                        </p>
                        <Badge variant="secondary">{member.role_label}</Badge>
                      </div>
                      <p className="text-sm text-muted-foreground">
                        {member.user.email || member.user.username}
                      </p>
                      <p className="mt-1 text-xs text-muted-foreground">
                        Joined {new Date(member.joined_at).toLocaleDateString()}
                      </p>
                    </div>

                    <div className="flex flex-col gap-2 sm:flex-row">
                      <Select
                        value={member.role}
                        onValueChange={(value: OrgRole) => handleRoleChange(member, value)}
                        disabled={updateRoleMutation.isPending || isLastOwner}
                      >
                        <SelectTrigger className="w-full sm:w-[180px]">
                          <SelectValue placeholder="Role" />
                        </SelectTrigger>
                        <SelectContent>
                          {memberRoleChoices.map((choice) => (
                            <SelectItem key={choice.value} value={choice.value}>
                              {choice.label}
                            </SelectItem>
                          ))}
                        </SelectContent>
                      </Select>
                      <Button
                        variant="outline"
                        disabled={removeMemberMutation.isPending || isLastOwner}
                        onClick={() => handleRemoveMember(member)}
                      >
                        <UserX className="mr-2 h-4 w-4" />
                        Remove
                      </Button>
                    </div>
                  </div>
                  {isLastOwner && (
                    <p className="mt-3 text-sm text-muted-foreground">
                      The final owner cannot be removed or demoted until ownership is transferred.
                    </p>
                  )}
                </div>
              )
            })}
          </CardContent>
        </Card>

        <Card>
          <CardHeader>
            <CardTitle>Pending invitations</CardTitle>
            <CardDescription>
              Outstanding org invitations stay visible until they are accepted, expire, or are
              revoked.
            </CardDescription>
          </CardHeader>
          <CardContent className="space-y-4">
            {pendingInvitations.length > 0 ? (
              pendingInvitations.map((invitation) => (
                <div
                  key={invitation.id}
                  className="flex flex-col gap-3 rounded-lg border p-4 sm:flex-row sm:items-center sm:justify-between"
                >
                  <div>
                    <p className="font-medium">{invitation.email}</p>
                    <p className="text-sm text-muted-foreground">
                      {invitation.role_label} invite expiring{' '}
                      {new Date(invitation.expires_at).toLocaleDateString()}
                    </p>
                  </div>
                  <Button
                    variant="outline"
                    disabled={revokeInvitationMutation.isPending}
                    onClick={() => handleRevokeInvitation(invitation.id)}
                  >
                    Revoke invite
                  </Button>
                </div>
              ))
            ) : (
              <p className="text-sm text-muted-foreground">No pending invitations right now.</p>
            )}
          </CardContent>
        </Card>
      </div>
    </div>
  )
}

{%- endraw %}
