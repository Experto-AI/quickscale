{% raw -%}
import { useState } from 'react'
import { Link } from 'react-router-dom'
import { Building2, ExternalLink } from 'lucide-react'
import { Button } from '@/components/ui/button'
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card'
import { Input } from '@/components/ui/input'
import { Label } from '@/components/ui/label'
import { getApiErrorMessage, getApiFieldErrors } from '@/hooks/useApi'
import { useOrgNavigation } from '@/hooks/useOrgNavigation'
import { useCreateOrg } from '@/hooks/useOrgs'

export function OrgCreatePage() {
  const { appPaths } = useOrgNavigation()
  const createOrgMutation = useCreateOrg()
  const [globalError, setGlobalError] = useState<string | null>(null)
  const [name, setName] = useState('')
  const fieldErrors = getApiFieldErrors(createOrgMutation.error)

  async function handleSubmit(event: React.FormEvent<HTMLFormElement>) {
    event.preventDefault()
    setGlobalError(null)

    try {
      const response = await createOrgMutation.mutateAsync({ name })
      window.location.assign(response.next_url)
    } catch (error) {
      const errors = getApiFieldErrors(error)
      if (!errors.name?.length) {
        setGlobalError(getApiErrorMessage(error))
      }
    }
  }

  return (
    <div className="mx-auto max-w-2xl space-y-6">
      <div>
        <h1 className="text-3xl font-bold tracking-tight">Create organization</h1>
        <p className="mt-1 text-muted-foreground">
          Name the organization, then QuickScale will send you to the next onboarding step. Billing pricing opens when that module is installed; otherwise the new org dashboard opens directly.
        </p>
      </div>

      <Card>
        <CardHeader>
          <CardTitle>Organization details</CardTitle>
          <CardDescription>
            Slugs are generated on the server. The returned onboarding URL opens with a full document redirect.
          </CardDescription>
        </CardHeader>
        <CardContent>
          <form onSubmit={handleSubmit} className="space-y-4">
            <div className="space-y-2">
              <Label htmlFor="organization-name">Organization name</Label>
              <Input
                id="organization-name"
                value={name}
                onChange={(event) => {
                  setName(event.target.value)
                  setGlobalError(null)
                }}
                placeholder="Acme Labs"
                autoComplete="organization"
              />
              {fieldErrors.name?.[0] && <p className="text-sm text-destructive">{fieldErrors.name[0]}</p>}
            </div>

            {globalError && (
              <div className="rounded-md border border-destructive/40 bg-destructive/10 px-4 py-3 text-sm text-destructive">
                {globalError}
              </div>
            )}

            <div className="flex flex-col gap-3 sm:flex-row">
              <Button type="submit" disabled={createOrgMutation.isPending || !name.trim()}>
                <Building2 className="mr-2 h-4 w-4" />
                {createOrgMutation.isPending ? 'Creating...' : 'Create organization'}
              </Button>
              <Button type="button" variant="outline" asChild>
                <Link to={appPaths.orgList}>Back to organizations</Link>
              </Button>
            </div>
          </form>
        </CardContent>
      </Card>

      <Card>
        <CardHeader>
          <CardTitle>What happens next?</CardTitle>
        </CardHeader>
        <CardContent className="space-y-2 text-sm text-muted-foreground">
          <p>1. QuickScale creates the organization and records you as the owner.</p>
          <p>2. The frontend performs a full redirect to the onboarding URL returned by `/api/orgs/`.</p>
          <p>3. Billing pricing opens when available; otherwise QuickScale lands on the new org-aware dashboard under your slug.</p>
          <div className="pt-2 text-foreground">
            Billing remains module-owned, so that onboarding step stays a Django page rather than a starter-owned React route. <ExternalLink className="ml-1 inline h-3 w-3" />
          </div>
        </CardContent>
      </Card>
    </div>
  )
}
{% endraw -%}
