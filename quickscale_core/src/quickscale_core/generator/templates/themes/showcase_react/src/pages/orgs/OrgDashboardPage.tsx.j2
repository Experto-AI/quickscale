{% raw -%}
import { Link } from 'react-router-dom'
import { Badge } from '@/components/ui/badge'
import { Button } from '@/components/ui/button'
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card'
import { ApiError } from '@/hooks/useApi'
import { buildOrgPath, useModules } from '@/hooks/useModules'
import { useOrgNavigation } from '@/hooks/useOrgNavigation'
import { isOrgAdminLike, useOrgBilling } from '@/hooks/useOrgs'
import { useOrgPageContext } from './OrgLayout'

export function OrgDashboardPage() {
  const { actor, organization } = useOrgPageContext()
  const modules = useModules()
  const { appPaths, currentOrgSlug } = useOrgNavigation()
  const billingEnabled = modules.billing && Boolean(currentOrgSlug)
  const canManageOrganization = isOrgAdminLike(actor)
  const canReadBilling = billingEnabled && actor.is_owner_like
  const { balance, subscription } = useOrgBilling(currentOrgSlug ?? '', canReadBilling)
  const actorRoleLabel =
    organization.role_label ?? (actor.is_owner_like ? 'Owner-like access' : null)
  const billingPath =
    billingEnabled && currentOrgSlug
      ? buildOrgPath(
          currentOrgSlug,
          actor.is_owner_like ? 'billing/dashboard/' : 'billing/pricing/',
        )
      : null
  const hasSubscription = Boolean(subscription.data)
  const subscriptionMissing =
    subscription.error instanceof ApiError && subscription.error.status === 404

  return (
    <div className="space-y-8">
      <div className="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
        <div>
          <div className="flex flex-wrap items-center gap-2">
            <h1 className="text-3xl font-bold tracking-tight">{organization.name}</h1>
            {actorRoleLabel && <Badge variant="secondary">{actorRoleLabel}</Badge>}
          </div>
          <p className="mt-2 text-muted-foreground">
            {billingEnabled
              ? `Org-aware dashboard for /${organization.slug} with billing and membership data loaded from the new SaaS contract.`
              : `Org-aware dashboard for /${organization.slug} with membership data loaded from the new SaaS contract.`}
          </p>
          <p className="mt-1 text-sm text-muted-foreground">
            {organization.member_count === 1
              ? '1 member'
              : `${organization.member_count ?? 0} members`}{' '}
            currently belong to this organization.
          </p>
        </div>
        <div className="flex flex-wrap gap-2">
          {canManageOrganization && (
            <Button variant="outline" asChild>
              <Link to={appPaths.members}>Manage members</Link>
            </Button>
          )}
          {canManageOrganization && (
            <Button variant="outline" asChild>
              <Link to={appPaths.settings}>Org settings</Link>
            </Button>
          )}
          {billingEnabled && billingPath && (
            <Button asChild>
              <a href={billingPath}>Open billing</a>
            </Button>
          )}
        </div>
      </div>

      <div
        className={`grid gap-4 md:grid-cols-2 ${canReadBilling ? 'xl:grid-cols-4' : 'xl:grid-cols-2'}`}
      >
        {canReadBilling && (
          <Card>
            <CardHeader>
              <CardTitle className="text-base">Current plan</CardTitle>
              <CardDescription>Reused from the billing subscription API.</CardDescription>
            </CardHeader>
            <CardContent>
              <div className="text-2xl font-bold">
                {subscription.isLoading
                  ? '…'
                  : hasSubscription
                    ? subscription.data?.plan.name
                    : 'No active plan'}
              </div>
              <p className="mt-2 text-sm text-muted-foreground">
                {hasSubscription
                  ? `${subscription.data?.plan.credits_per_period ?? 0} credits per ${subscription.data?.plan.billing_interval ?? 'period'}`
                  : subscriptionMissing
                    ? 'Choose a pricing plan to activate module entitlements for this organization.'
                    : 'Subscription details are temporarily unavailable.'}
              </p>
            </CardContent>
          </Card>
        )}

        {canReadBilling && (
          <Card>
            <CardHeader>
              <CardTitle className="text-base">Credit balance</CardTitle>
              <CardDescription>Read from the org-scoped billing balance API.</CardDescription>
            </CardHeader>
            <CardContent>
              <div className="text-2xl font-bold">
                {balance.isLoading ? '…' : (balance.data?.balance ?? 0)}
              </div>
              <p className="mt-2 text-sm text-muted-foreground">
                {balance.data?.updated_at
                  ? `Updated ${new Date(balance.data.updated_at).toLocaleString()}`
                  : 'A zero-balance row is created on first read when no credits exist yet.'}
              </p>
            </CardContent>
          </Card>
        )}

        <Card>
          <CardHeader>
            <CardTitle className="text-base">Your access</CardTitle>
            <CardDescription>
              The org detail API remains the source of truth for role and owner-like access.
            </CardDescription>
          </CardHeader>
          <CardContent>
            <div className="text-2xl font-bold">{actorRoleLabel ?? 'Viewer'}</div>
            <p className="mt-2 text-sm text-muted-foreground">
              {actor.is_owner_like
                ? 'You have owner-level access for billing and membership changes.'
                : canManageOrganization
                  ? 'You can manage members and organization settings.'
                  : 'You can view the workspace but admin surfaces stay restricted.'}
            </p>
          </CardContent>
        </Card>

        <Card>
          <CardHeader>
            <CardTitle className="text-base">Quick links</CardTitle>
            <CardDescription>
              {billingEnabled
                ? 'Switch between the new org-aware surfaces from this dashboard.'
                : 'Switch between the org-aware membership and settings surfaces from this dashboard.'}
            </CardDescription>
          </CardHeader>
          <CardContent className="space-y-2">
            {billingEnabled && billingPath && (
              <Button variant="outline" className="w-full justify-start" asChild>
                <a href={billingPath}>Billing</a>
              </Button>
            )}
            <Button variant="outline" className="w-full justify-start" asChild>
              <Link to={appPaths.members}>Members</Link>
            </Button>
            <Button variant="outline" className="w-full justify-start" asChild>
              <Link to={appPaths.settings}>Settings</Link>
            </Button>
            {!billingEnabled && (
              <p className="text-sm text-muted-foreground">
                Billing links stay hidden until the billing module is installed.
              </p>
            )}
          </CardContent>
        </Card>
      </div>
    </div>
  )
}

{%- endraw %}
