import { test, expect } from '@playwright/test';

test('has title', async ({ page }) => {
  await page.goto('/');

  // Expect a title "to contain" the project name.
  await expect(page).toHaveTitle(/{{ project_name }}/);
});

test('dashboard welcomes the project', async ({ page }) => {
  await page.goto('/');

  // The dashboard heading comes from Dashboard.tsx and the runtime seam.
  await expect(
    page.getByRole('heading', { name: 'Welcome to {{ project_name }}' }),
  ).toBeVisible();
});
