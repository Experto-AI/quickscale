/* {{ project_name }} - Base Styles */

/* Global Styles */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    line-height: 1.6;
    color: #0f172a;
    background: linear-gradient(180deg, #f8fafc 0%, #ffffff 240px, #f8fafc 100%);
    min-height: 100vh;
}

a {
    color: #2563eb;
    text-decoration: none;
}

a:hover {
    text-decoration: underline;
}

.qs-header {
    background: rgba(248, 250, 252, 0.92);
    border-bottom: 1px solid #e2e8f0;
    backdrop-filter: blur(12px);
}

.qs-topbar {
    max-width: 1024px;
    margin: 0 auto;
    padding: 0.85rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    flex-wrap: wrap;
}

.qs-brand-stack {
    display: grid;
    gap: 0.15rem;
}

.qs-topbar-brand {
    font-size: 1.125rem;
    font-weight: 600;
    color: #0f172a;
    text-decoration: none;
}

.qs-topbar-brand:hover {
    text-decoration: none;
}

.qs-topbar-label {
    color: #64748b;
    font-size: 0.85rem;
}

.qs-topbar-nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
}

.qs-topbar-link {
    display: inline-flex;
    align-items: center;
    padding: 0.38rem 0.72rem;
    border: 1px solid transparent;
    border-radius: 999px;
    color: #64748b;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
}

.qs-topbar-link:hover {
    background: #ffffff;
    border-color: #e2e8f0;
    color: #0f172a;
    text-decoration: none;
}

.qs-topbar-status {
    display: inline-flex;
    align-items: center;
    padding: 0.28rem 0.65rem;
    border-radius: 999px;
    background: #dbeafe;
    color: #1d4ed8;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
}

.qs-topbar-status-muted {
    background: #e2e8f0;
    color: #475569;
}

/* Messages */
.qs-main {
    max-width: 1024px;
    margin: 0 auto;
    padding: 2rem 1.5rem 3rem;
}

.qs-messages {
    display: grid;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
}

.qs-alert {
    padding: 0.75rem 1rem;
    border-radius: 0.75rem;
    border: 1px solid;
    font-size: 0.875rem;
    font-weight: 500;
}

.qs-alert-success {
    background: #f0fdf4;
    color: #166534;
    border-color: #bbf7d0;
}

.qs-alert-error,
.qs-alert-danger {
    background: #fef2f2;
    color: #991b1b;
    border-color: #fecaca;
}

.qs-alert-warning {
    background: #fffbeb;
    color: #92400e;
    border-color: #fde68a;
}

.qs-alert-info {
    background: #eff6ff;
    color: #1e40af;
    border-color: #bfdbfe;
}

/* Dashboard */
.dashboard-shell {
    display: grid;
    gap: 2.5rem;
}

.dashboard-intro {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
}

.dashboard-intro-copy {
    max-width: 64ch;
}

.dashboard-kicker {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    padding: 0.28rem 0.7rem;
    margin-bottom: 1rem;
    border-radius: 999px;
    background: #eff6ff;
    color: #1d4ed8;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
}

.dashboard-intro h1 {
    color: #0f172a;
    font-size: clamp(2.2rem, 4vw, 3rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
}

.dashboard-copy {
    margin-top: 0.85rem;
    color: #64748b;
    font-size: 1.05rem;
}

.dashboard-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    align-items: center;
}

.dashboard-group {
    display: grid;
    gap: 1rem;
}

.dashboard-group-heading h2 {
    color: #0f172a;
    font-size: 1.25rem;
}

.dashboard-group-heading p {
    margin-top: 0.35rem;
    color: #64748b;
    max-width: 62ch;
}

.dashboard-card-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
}

.module-card,
.info-card {
    height: 100%;
    padding: 1.25rem;
    border-radius: 1rem;
    border: 1px solid #e2e8f0;
    background: #ffffff;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.05);
}

.module-card {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
}

.module-card-header {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
}

.module-card-header h3,
.info-card h3 {
    color: #0f172a;
    font-size: 1rem;
}

.module-badge {
    margin-left: auto;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    background: #f1f5f9;
    color: #334155;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
}

.module-card p,
.info-card p {
    color: #475569;
}

.module-card-actions {
    margin-top: auto;
    padding-top: 0.15rem;
}

.module-link,
.resource-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    padding: 0.65rem 0.9rem;
    border-radius: 0.85rem;
    border: 1px solid #cbd5e1;
    background: #ffffff;
    color: #0f172a;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
}

.module-link:hover,
.resource-link:hover {
    background: #f8fafc;
    border-color: #94a3b8;
    color: #0f172a;
    text-decoration: none;
}

.module-note {
    font-size: 0.92rem;
    color: #64748b;
}

.empty-state {
    grid-column: 1 / -1;
    justify-content: center;
}

.info-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
}

.resource-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
}

/* Public Social Surfaces */
.qs-social-shell {
    display: grid;
    gap: 1.5rem;
    align-items: start;
}

@media (min-width: 960px) {
    .qs-social-shell {
        grid-template-columns: minmax(240px, 280px) minmax(0, 1fr);
    }
}

.qs-social-rail,
.qs-social-stack {
    display: grid;
    gap: 1.5rem;
}

.qs-social-rail,
.qs-social-hero,
.qs-social-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 18px;
    padding: 1.5rem;
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
}

.qs-social-rail {
    position: sticky;
    top: 1.5rem;
    background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
}

.qs-social-rail-eyebrow {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    padding: 0.28rem 0.7rem;
    border-radius: 999px;
    background: #e2e8f0;
    color: #0f172a;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
}

.qs-social-rail h1,
.qs-social-hero h1 {
    color: #0f172a;
    line-height: 1.1;
}

.qs-social-rail h1 {
    font-size: 1.5rem;
    margin-bottom: 0;
}

.qs-social-hero h1 {
    font-size: 2rem;
    margin: 1rem 0 0;
}

.qs-social-rail-copy,
.qs-social-copy,
.qs-social-card p,
.qs-social-card li {
    color: #475569;
}

.qs-social-copy {
    margin-top: 0.75rem;
    max-width: 62ch;
}

.qs-social-rail-group,
.qs-social-meta,
.qs-social-meta div,
.qs-social-nav {
    display: grid;
}

.qs-social-rail-group,
.qs-social-meta {
    gap: 0.75rem;
}

.qs-social-meta div {
    gap: 0.2rem;
}

.qs-social-rail-label {
    color: #64748b;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
}

.qs-social-nav {
    gap: 0.65rem;
}

.qs-social-nav-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.8rem 0.95rem;
    border-radius: 0.85rem;
    border: 1px solid #cbd5e1;
    background: #ffffff;
    color: #0f172a;
    font-weight: 600;
    text-decoration: none;
}

.qs-social-nav-link:hover {
    background: #eff6ff;
    border-color: #93c5fd;
    text-decoration: none;
}

.qs-social-nav-link-active {
    background: #0f172a;
    border-color: #0f172a;
    color: #ffffff;
}

.qs-social-nav-link-active:hover {
    background: #1e293b;
    border-color: #1e293b;
}

.qs-social-meta dt {
    color: #64748b;
    font-size: 0.84rem;
}

.qs-social-meta dd {
    margin: 0;
    color: #0f172a;
    font-weight: 600;
}

.qs-social-pill {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    background: #dbeafe;
    color: #1d4ed8;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
}

.qs-social-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
}

.qs-social-card h2 {
    color: #0f172a;
    font-size: 1.05rem;
    margin-bottom: 0.5rem;
}

.qs-social-list {
    margin: 0;
    padding-left: 1.1rem;
}

.qs-social-empty {
    border-style: dashed;
    background: linear-gradient(135deg, #f8fafc 0%, #eff6ff 100%);
}

.qs-social-empty p + p {
    margin-top: 0.65rem;
}

code {
    background: #f1f5f9;
    padding: 0.2rem 0.45rem;
    border-radius: 0.35rem;
    font-family: "Courier New", monospace;
    font-size: 0.88em;
    color: #0f172a;
}

/* Footer */
.qs-footer {
    text-align: center;
    padding: 1.5rem;
    color: #94a3b8;
    font-size: 0.8rem;
    border-top: 1px solid #e2e8f0;
    margin-top: 3rem;
}

.qs-footer p {
    font-size: inherit;
}

/* Form Styles */
.auth-container {
    max-width: 960px;
    margin: 0 auto;
    padding: 2rem 1.5rem 3rem;
}

.auth-header {
    text-align: left;
    margin-bottom: 1.5rem;
}

.auth-header h1 {
    color: #0f172a;
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.02em;
}

.auth-main {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 400px;
}

.auth-form-container {
    background: #ffffff;
    padding: 2.25rem;
    border-radius: 1rem;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.05), 0 18px 40px rgba(15, 23, 42, 0.08);
    max-width: 480px;
    width: 100%;
    border: 1px solid #e2e8f0;
}

.auth-form-container h2 {
    color: #0f172a;
    margin-bottom: 0.5rem;
    font-size: 1.875rem;
    font-weight: 700;
    text-align: left;
    letter-spacing: -0.02em;
}

.auth-subtitle {
    color: #64748b;
    margin-bottom: 2rem;
    text-align: left;
    font-size: 1rem;
}

.auth-form {
    margin-top: 1rem;
}

.form-group {
    margin-bottom: 1.5rem;
}

.form-group label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 600;
    color: #334155;
    font-size: 0.9rem;
}

.form-group input[type="text"],
.form-group input[type="email"],
.form-group input[type="password"],
.form-group input[type="checkbox"] {
    font-size: 1rem;
}

.form-group input[type="text"],
.form-group input[type="email"],
.form-group input[type="password"] {
    width: 100%;
    padding: 0.75rem;
    border: 1px solid #cbd5e1;
    border-radius: 0.75rem;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
    background: #ffffff;
}

.form-group input:focus {
    outline: none;
    border-color: #94a3b8;
    box-shadow: 0 0 0 3px rgba(191, 219, 254, 0.5);
}

.form-group.has-error input {
    border-color: #dc2626;
}

.error-message,
.errorlist {
    display: block;
    color: #dc2626;
    font-size: 0.875rem;
    margin-top: 0.25rem;
    font-weight: 500;
}

.errorlist {
    list-style: none;
    padding: 0;
    margin: 0.5rem 0 0 0;
}

.form-text,
.helptext {
    display: block;
    color: #64748b;
    font-size: 0.875rem;
    margin-top: 0.25rem;
}

.form-errors {
    background: #fef2f2;
    border: 1px solid #fecaca;
    border-radius: 0.75rem;
    padding: 1rem;
    margin-bottom: 1rem;
}

.form-errors .error {
    color: #991b1b;
    margin: 0;
}

.form-actions {
    margin-top: 2rem;
}

.btn,
button[type="submit"] {
    padding: 0.75rem 1rem;
    border: 1px solid transparent;
    border-radius: 0.75rem;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    background: #0f172a;
    color: white;
}

.btn:hover,
button[type="submit"]:hover {
    background: #1e293b;
    text-decoration: none;
}

.btn-primary {
    background: #0f172a;
    color: white;
}

.btn-primary:hover {
    background: #1e293b;
}

.btn-secondary {
    background: #ffffff;
    border-color: #cbd5e1;
    color: #0f172a;
}

.btn-secondary:hover {
    background: #f8fafc;
}

.btn-danger {
    background: #dc2626;
    color: white;
}

.btn-danger:hover {
    background: #b91c1c;
}

.btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
}

.btn-inline {
    width: auto;
}

.auth-links {
    margin-top: 2rem;
    text-align: left;
    padding-top: 1.5rem;
    border-top: 1px solid #e2e8f0;
}

.auth-links p {
    margin: 0.5rem 0;
    color: #64748b;
}

.auth-links a {
    color: #2563eb;
    text-decoration: none;
    font-weight: 500;
}

.auth-links a:hover {
    text-decoration: underline;
}

/* Profile Styles */
.profile-info {
    margin: 2rem 0;
    padding: 1.5rem;
    background: #ffffff;
    border-radius: 0.75rem;
    border: 1px solid #e2e8f0;
}

.profile-info p {
    margin: 0.75rem 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.profile-info strong {
    color: #0f172a;
    font-weight: 600;
    min-width: 120px;
}

.profile-actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 2rem;
}

.warning {
    padding: 1rem;
    background: #fffbeb;
    color: #92400e;
    border: 1px solid #fde68a;
    border-radius: 0.75rem;
    margin-bottom: 1.5rem;
}

/* Responsive Design */
@media (max-width: 768px) {
    .qs-topbar,
    .qs-main {
        padding-left: 1rem;
        padding-right: 1rem;
    }

    .dashboard-intro {
        flex-direction: column;
    }

    .dashboard-actions {
        width: 100%;
    }

    .btn-inline {
        width: 100%;
    }

    .qs-social-rail {
        position: static;
    }

    .auth-container {
        padding: 1rem;
    }

    .auth-form-container {
        padding: 2rem 1.5rem;
    }

    .auth-header h1 {
        font-size: 1.5rem;
    }
}
