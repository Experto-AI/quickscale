{%raw%}{% extends "base.html" %}
{% load static %}

{% block title %}Social Embeds | {% endraw %}{{ project_name }}{%raw%}{% endblock %}

{% block content %}
<div class="qs-social-shell">

    {# --- Rail (sidebar) --- #}
    <aside class="qs-social-rail">
        <span class="qs-social-rail-eyebrow">Public social routing</span>
        <h1>Social Embeds</h1>

        {% if social %}
        <div class="qs-social-rail-group">
            <dl class="qs-social-meta">
                <div>
                    <dt class="qs-social-rail-label">Public route</dt>
                    <dd>{{ social.public_path }}</dd>
                </div>
                <div>
                    <dt class="qs-social-rail-label">Published embeds</dt>
                    <dd>{{ social.total_embeds }}</dd>
                </div>
                <div>
                    <dt class="qs-social-rail-label">Per page</dt>
                    <dd>{{ social.embeds_per_page }}</dd>
                </div>
            </dl>
        </div>
        {% endif %}

        <nav class="qs-social-nav" aria-label="Social surfaces">
            <a class="qs-social-nav-link" href="/social/">Link Tree</a>
            <a class="qs-social-nav-link qs-social-nav-link-active" href="/social/embeds/" aria-current="page">Embeds</a>
            <a class="qs-social-nav-link" href="/">Home</a>
        </nav>
    </aside>

    {# --- Main content --- #}
    <div class="qs-social-stack">

        {% if social is None %}
        {# Social module not installed #}
        <section class="qs-social-card qs-social-empty">
            <h2>Social module not active</h2>
            <p>
                This page reserves <code>/social/embeds</code>, but the managed embed gallery only
                renders when the social module is installed and embed publishing is enabled.
            </p>
            <p>
                Use <code>quickscale plan --add social</code> then <code>quickscale apply</code> to
                enable the module.
            </p>
        </section>

        {% elif social.status == 'error' %}
        <section class="qs-social-card" style="border-color: #fecaca; background: #fef2f2;">
            <h2>Social configuration needs attention</h2>
            <p style="color: #991b1b;">{{ social.error }}</p>
            <p style="color: #991b1b;">Fix the social settings and reload to restore the public embed gallery.</p>
        </section>

        {% elif social.status == 'disabled' %}
        <section class="qs-social-card" style="border-color: #fde68a; background: #fffbeb;">
            <h2>Embed gallery paused</h2>
            <p style="color: #92400e;">
                The route still resolves publicly, but embed publishing is currently disabled in the
                managed social settings.
            </p>
            <p style="color: #92400e;">
                When embed publishing is re-enabled, this route will immediately start rendering the
                gallery.
            </p>
        </section>

        {% elif social.total_embeds == 0 %}
        <section class="qs-social-card qs-social-empty" style="border-color: #bfdbfe; background: #eff6ff;">
            <h2>Ready for the first embed</h2>
            <p>
                The public route is live, but no social embeds have been published yet.
            </p>
            <p>
                Once the social module publishes its first embed, this page will become a shareable
                media gallery. The cap is <strong>{{ social.embeds_per_page }}</strong> embeds per page.
            </p>
            <p>
                <a class="module-link" href="/admin/quickscale_modules_social/socialembed/add/">Add first embed in admin</a>
            </p>
        </section>

        {% else %}
        {# Embeds are available — render gallery #}
        <section class="qs-social-card">
            <div class="module-card-header" style="margin-bottom: 0.75rem;">
                <span class="qs-social-pill">Embed gallery</span>
                <span class="module-note" style="margin-left: auto;">{{ social.total_embeds }} published embed{{ social.total_embeds|pluralize }}</span>
            </div>
            <h2>Published embeds</h2>
            <p class="qs-social-copy">
                Each embed is rendered from the managed data. Thumbnails and embed frames are shown
                when the resolution process has completed.
            </p>
        </section>

        <div class="qs-social-grid">
            {% for embed in social.embeds %}
            <article class="qs-social-card">
                <div class="module-card-header">
                    <span class="qs-social-pill">{{ embed.provider_display_name }}</span>
                    <span class="module-note" style="margin-left: auto;">#{{ embed.display_order }}</span>
                </div>

                {% if embed.thumbnail_url %}
                <img src="{{ embed.thumbnail_url }}" alt="{{ embed.title }}"
                     style="width: 100%; border-radius: 8px; margin: 0.5rem 0; object-fit: cover; max-height: 160px;"
                     loading="lazy">
                {% endif %}

                <h2>{{ embed.title }}</h2>
                {% if embed.description %}
                <p>{{ embed.description }}</p>
                {% endif %}

                {% if embed.resolution_status == 'resolved' and embed.embed_url %}
                <p class="module-note">Resolution: resolved</p>
                {% elif embed.resolution_status == 'pending' %}
                <p class="module-note">Resolution: pending — thumbnail and frame will appear after the background resolver runs.</p>
                {% elif embed.resolution_status == 'error' %}
                <p class="module-note" style="color: #991b1b;">Resolution error: {{ embed.resolution_error }}</p>
                {% endif %}

                <div class="module-card-actions">
                    <a class="module-link" href="{{ embed.url }}" target="_blank" rel="noopener noreferrer">
                        View on {{ embed.provider_display_name }} ↗
                    </a>
                </div>
            </article>
            {% endfor %}
        </div>
        {% endif %}

    </div>
</div>
{% endblock %}{%endraw%}
