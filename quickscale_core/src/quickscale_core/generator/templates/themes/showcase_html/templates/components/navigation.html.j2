{%raw%}<nav class="qs-topbar">
    <div class="qs-brand-stack">
        <a href="/" class="qs-topbar-brand">{% endraw %}{{ project_name }}{%raw%}</a>
        <span class="qs-topbar-label">Showcase HTML starter</span>
    </div>

    <div class="qs-topbar-nav">
        <a href="/" class="qs-topbar-link">App</a>

        {% if 'quickscale_modules_orgs' in settings.INSTALLED_APPS and settings.QUICKSCALE_MODE == 'saas' %}
        <a href="/orgs/" class="qs-topbar-link">Organizations</a>
        {% endif %}

        {% if 'quickscale_modules_blog' in settings.INSTALLED_APPS %}
        <a href="{% url 'quickscale_blog:post_list' %}" class="qs-topbar-link">Blog</a>
        {% endif %}

        {% if 'quickscale_modules_listings' in settings.INSTALLED_APPS %}
        <a href="{% url 'quickscale_listings:listing_list' %}" class="qs-topbar-link">Listings</a>
        {% endif %}

        {% if 'quickscale_modules_crm' in settings.INSTALLED_APPS %}
        {% if user.is_staff %}
        <a href="{% url 'quickscale_crm:dashboard' %}" class="qs-topbar-link">CRM</a>
        {% endif %}
        {% endif %}

        {% if 'quickscale_modules_forms' in settings.INSTALLED_APPS %}
        <a href="/admin/quickscale_modules_forms/form/" class="qs-topbar-link">Forms</a>
        {% endif %}

        {% if 'quickscale_modules_billing' in settings.INSTALLED_APPS %}
        {% if user.is_authenticated %}
        <a href="{{ modules.billing.url }}" class="qs-topbar-link">Billing</a>
        {% else %}
        <a href="/billing/pricing/" class="qs-topbar-link">Pricing</a>
        {% endif %}
        {% endif %}

        {% if 'quickscale_modules_social' in settings.INSTALLED_APPS %}
        {% if settings.QUICKSCALE_SOCIAL_LINK_TREE_ENABLED %}
        <a href="/social/" class="qs-topbar-link">Social</a>
            {% endif %}
            {% if settings.QUICKSCALE_SOCIAL_EMBEDS_ENABLED %}
        <a href="/social/embeds/" class="qs-topbar-link">Embeds</a>
        {% endif %}
        {% endif %}

        {% if 'quickscale_modules_auth' in settings.INSTALLED_APPS %}
        {% if user.is_authenticated %}
        <a href="{% url 'quickscale_auth:profile' %}" class="qs-topbar-link">Profile</a>
        <a href="{% url 'account_logout' %}" class="qs-topbar-link">Logout</a>
        <span class="qs-topbar-status">Signed in</span>
        {% else %}
        <a href="{% url 'account_login' %}" class="qs-topbar-link">Sign in</a>
        <a href="{% url 'account_signup' %}" class="qs-topbar-link">Sign up</a>
        <span class="qs-topbar-status qs-topbar-status-muted">Guest</span>
        {% endif %}
        {% endif %}

        <a href="/admin/" class="qs-topbar-link">Admin</a>
        <a href="https://github.com/Experto-AI/quickscale" target="_blank" rel="noopener noreferrer" class="qs-topbar-link">Docs</a>
    </div>
</nav>{%endraw%}
