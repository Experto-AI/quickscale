-- PostgreSQL initialization script for {{ project_name }}.
--
-- Creates a restricted runtime database role with NOSUPERUSER and NOBYPASSRLS
-- so per-table Row-Level Security (RLS) policies actually enforce tenant isolation.
--
-- This script is auto-generated by QuickScale and runs automatically when the
-- PostgreSQL container first initializes (docker-entrypoint-initdb.d). For
-- manual/production deploys, run this SQL as a database superuser.
--
-- The runtime role has:
--   - LOGIN (can connect to the database)
--   - NOSUPERUSER (cannot bypass permissions)
--   - NOBYPASSRLS (RLS policies are enforced for this role)
--   - NOCREATEDB / NOCREATEROLE (limited privileges)
--   - DML grants (SELECT, INSERT, UPDATE, DELETE) on all existing and future tables
--   - USAGE grants on all existing and future sequences (required for auto-increment PKs)
--
-- The operator/superuser role (used for migrations, schema changes, and
-- management commands) is the original POSTGRES_USER — it retains CREATEDB,
-- CREATEROLE, and BYPASSRLS so schema migrations and administrative operations
-- continue to work.

DO $$
BEGIN
  IF NOT EXISTS (SELECT FROM pg_catalog.pg_roles WHERE rolname = '{{ runtime_db_role }}') THEN
    CREATE ROLE "{{ runtime_db_role }}" WITH
{% for attribute in runtime_db_role_attributes %}
      {{ attribute }}
{% endfor %}
      PASSWORD '{{ runtime_db_password }}';
  END IF;
END
$$;

-- Apply the canonical runtime grants to the current database and public schema.
{% for statement in runtime_db_init_grant_statements %}
{{ statement }};
{% endfor %}

-- Mark generated initialization complete only after every required statement succeeds.
ALTER DATABASE "{{ package_name }}" SET quickscale.init_complete TO 'true';
