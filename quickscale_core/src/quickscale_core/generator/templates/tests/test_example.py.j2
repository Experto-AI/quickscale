"""Example tests demonstrating pytest patterns for {{ project_name }}"""

import importlib

import pytest
from django.contrib.auth import get_user_model
from django.test import RequestFactory

from {{ package_name }} import views

User = get_user_model()


@pytest.mark.django_db
class TestUserModel:
    """Tests for User model"""

    def test_create_user(self, user_data):
        """Test user creation"""
        user = User.objects.create_user(**user_data)

        assert user.username == user_data["username"]
        assert user.email == user_data["email"]
        assert user.check_password(user_data["password"])
        assert not user.is_staff
        assert not user.is_superuser

    def test_create_superuser(self):
        """Test superuser creation"""
        admin = User.objects.create_superuser(
            username="admin",
            email="admin@example.com",
            password="adminpass123",
        )

        assert admin.is_staff
        assert admin.is_superuser

    def test_user_string_representation(self, user):
        """Test user __str__ method"""
        assert str(user) == user.username


@pytest.mark.django_db
class TestAuthentication:
    """Tests for authentication"""

    def test_user_can_login(self, client, user):
        """Test that user can log in"""
        response = client.login(username=user.username, password="testpass123")
        assert response is True

    def test_user_cannot_login_with_wrong_password(self, client, user):
        """Test that login fails with wrong password"""
        response = client.login(username=user.username, password="wrongpassword")
        assert response is False


@pytest.mark.django_db
class TestProjectSurface:
    """Tests for the generated URL surface and application entry points."""

    def test_healthcheck_returns_ok(self, client):
        """The healthcheck endpoint answers monitoring services with a plain-text OK."""
        response = client.get("/healthcheck/")
        assert response.status_code == 200
        assert response.content == b"OK"

    def test_readiness_returns_ok(self, client):
        """Readiness proves the database is reached and every migration is applied."""
        response = client.get("/ready/")
        assert response.status_code == 200
        assert response.content == b"OK"

    def test_home_shell_renders(self, client):
        """The root route serves the React shell template."""
        response = client.get("/")
        assert response.status_code == 200

    def test_application_entry_points_import(self):
        """The WSGI and ASGI entry points import cleanly."""
        importlib.import_module("{{ package_name }}.asgi")
        importlib.import_module("{{ package_name }}.wsgi")

    def test_error_handlers_render(self, user):
        """The custom error handlers render their templates."""
        request = RequestFactory().get("/missing")
        request.user = user
        assert views.custom_404_view(request).status_code == 404
        assert views.custom_500_view(request).status_code == 500

    def test_orgs_shell_view_renders_for_signed_in_user(self, user):
        """The org shell view renders for a signed-in user."""
        request = RequestFactory().get("/orgs")
        request.user = user
        assert views.orgs_react_shell_view(request).status_code == 200
