#!/usr/bin/env bash
# Railway deployment startup script
# This script runs migrations and starts the Gunicorn server

set -e  # Exit on error
set -u  # Exit on undefined variable

# Disable Python output buffering to see logs immediately
export PYTHONUNBUFFERED=1

echo "========================================"
echo "🚀 Starting deployment..."
echo "========================================"
echo ""

echo "📋 Step 1/7: Environment check"
echo "Checking critical environment variables..."
critical_vars=(DATABASE_URL SECRET_KEY DEBUG DJANGO_SETTINGS_MODULE ALLOWED_HOSTS PORT)
missing_critical_var=0

for var_name in "${critical_vars[@]}"; do
  if [[ -n "${!var_name:-}" ]]; then
    echo "${var_name}: set"
  else
    echo "${var_name}: MISSING"
    missing_critical_var=1
  fi
done

if [[ "$missing_critical_var" -eq 1 ]]; then
  echo "⚠️  Some variables may be missing"
fi
echo ""

echo "📋 Step 2/7: Python environment"
python --version
echo "Python location: $(which python)"
echo "Installed packages:"
pip list | grep -E '(Django|gunicorn|psycopg|dj-database-url|whitenoise)' || echo "⚠️  Some packages may be missing"
echo ""
echo "Django configuration check:"
python -c "from django.conf import settings; print(f'ALLOWED_HOSTS: {settings.ALLOWED_HOSTS}')" || echo "⚠️  Could not load Django settings"
echo ""

echo "📋 Step 3/7: Database migrations"
echo "Running migrations..."
# Unset RUNTIME_DATABASE_URL so migrations use the superuser DATABASE_URL
# (the runtime role has NOSUPERUSER/NOBYPASSRLS and cannot run DDL).
RUNTIME_DATABASE_URL="" python manage.py migrate --noinput
echo "✅ Migrations completed successfully"
echo ""

echo "📋 Step 4/7: Cache table setup"
# Only needed for DatabaseCache — RedisCache is managed automatically.
# Unset RUNTIME_DATABASE_URL so createcachetable uses the superuser DATABASE_URL
# (the runtime role has NOSUPERUSER/NOBYPASSRLS and cannot run DDL).
if [[ -z "${REDIS_URL:-}" ]]; then
    echo "REDIS_URL not set — creating database cache table via superuser DATABASE_URL..."
    RUNTIME_DATABASE_URL="" python manage.py createcachetable
    echo "✅ Cache table ready"
else
    echo "REDIS_URL set — skipping database cache table (using Redis)"
fi
echo ""

echo "📋 Step 5/7: Superuser setup"
DJANGO_SUPERUSER_USERNAME="${DJANGO_SUPERUSER_USERNAME:-}"
DJANGO_SUPERUSER_EMAIL="${DJANGO_SUPERUSER_EMAIL:-}"
DJANGO_SUPERUSER_PASSWORD="${DJANGO_SUPERUSER_PASSWORD:-}"
if [[ -n "$DJANGO_SUPERUSER_USERNAME" && -n "$DJANGO_SUPERUSER_EMAIL" && -n "$DJANGO_SUPERUSER_PASSWORD" ]]; then
  echo "Attempting to create superuser '$DJANGO_SUPERUSER_USERNAME' (skipped if already exists)..."
  python manage.py shell -c "
import os
from django.contrib.auth import get_user_model
User = get_user_model()
username = os.environ['DJANGO_SUPERUSER_USERNAME']
if User.objects.filter(username=username).exists():
    print(f'Superuser {username!r} already exists, skipping.')
else:
    User.objects.create_superuser(username, os.environ['DJANGO_SUPERUSER_EMAIL'], os.environ['DJANGO_SUPERUSER_PASSWORD'])
    print(f'Superuser {username!r} created successfully.')
" || echo "⚠️  Superuser setup failed (non-fatal), continuing..."
else
  echo "ℹ️  DJANGO_SUPERUSER_* vars not set, skipping superuser creation."
fi
echo ""

echo "📋 Step 6/7: WSGI application check"
python -c "from {{ package_name }}.wsgi import application; print(f'✅ WSGI app loaded: {type(application).__name__}')"
echo ""

gunicorn_workers="${GUNICORN_WORKERS:-${WEB_CONCURRENCY:-1}}"

echo "📋 Step 7/7: Starting Gunicorn"
echo "Binding to 0.0.0.0:${PORT:-8000} with ${gunicorn_workers} workers"
echo "Gunicorn will log all requests below..."
echo "========================================"
echo ""

# Start Gunicorn with detailed logging
exec gunicorn {{ package_name }}.wsgi:application \
    --bind "0.0.0.0:${PORT:-8000}" \
  --workers "${gunicorn_workers}" \
    --timeout 60 \
    --log-level info \
    --access-logfile - \
    --error-logfile - \
    --capture-output \
    --enable-stdio-inheritance
