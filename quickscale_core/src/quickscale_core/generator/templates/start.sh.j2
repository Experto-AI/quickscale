#!/usr/bin/env bash
# Railway deployment startup script
# This script runs migrations and starts the Gunicorn server

set -e  # Exit on error
set -u  # Exit on undefined variable

# Disable Python output buffering to see logs immediately
export PYTHONUNBUFFERED=1

# Explicit one-shot data migration mode. This branch never starts Gunicorn and
# keeps the privileged command marker scoped to this single process.
if [[ "$#" -gt 0 ]]; then
  if [[ "$#" -eq 1 && "$1" == "migrate_billing_to_orgs" ]]; then
    echo "Running one-shot billing organization migration..."
    QUICKSCALE_PRIVILEGED_COMMAND=migrate_billing_to_orgs RUNTIME_DATABASE_URL="" exec python manage.py migrate_billing_to_orgs
  fi
  echo "ERROR: unsupported start.sh command: $*" >&2
  exit 2
fi

echo "========================================"
echo "🚀 Starting deployment..."
echo "========================================"
echo ""

echo "📋 Step 1/8: Environment check"
echo "Checking critical environment variables..."
critical_vars=(DATABASE_URL SECRET_KEY DEBUG DJANGO_SETTINGS_MODULE ALLOWED_HOSTS PORT)
missing_critical_var=0

for var_name in "${critical_vars[@]}"; do
  if [[ -n "${!var_name:-}" ]]; then
    echo "${var_name}: set"
  else
    echo "${var_name}: MISSING"
    missing_critical_var=1
  fi
done

if [[ "$missing_critical_var" -eq 1 ]]; then
  echo "⚠️  Some variables may be missing"
fi
echo ""

echo "📋 Step 2/8: Python environment"
python --version
echo "Python location: $(which python)"
echo "Installed packages:"
pip list | grep -E '(Django|gunicorn|psycopg|dj-database-url|whitenoise)' || echo "⚠️  Some packages may be missing"
echo ""
echo "Django configuration check:"
python -c "from django.conf import settings; print(f'ALLOWED_HOSTS: {settings.ALLOWED_HOSTS}')" || echo "⚠️  Could not load Django settings"
echo ""

echo "📋 Step 3/8: Runtime database role"
# When RUNTIME_DB_PASSWORD is set (quickscale deploy railway sets it), create or
# update the restricted NOSUPERUSER/NOBYPASSRLS role that RUNTIME_DATABASE_URL
# logs in as, using the superuser DATABASE_URL. Idempotent: every boot re-syncs
# the password and grants. Credentials are read from the environment inside
# Python, never passed on a command line. Without RUNTIME_DB_PASSWORD the role
# is operator-managed and this step is skipped.
if [[ -n "${RUNTIME_DB_PASSWORD:-}" ]]; then
  python - <<'PY'
import os

import psycopg2
from psycopg2 import sql

role = os.environ.get("RUNTIME_DB_ROLE") or "quickscale_runtime"
password = os.environ["RUNTIME_DB_PASSWORD"]
ident = sql.Identifier(role)
attributes = sql.SQL("LOGIN NOSUPERUSER NOBYPASSRLS NOCREATEDB NOCREATEROLE PASSWORD {}").format(
    sql.Literal(password)
)

connection = psycopg2.connect(os.environ["DATABASE_URL"])
connection.autocommit = True
with connection.cursor() as cursor:
    cursor.execute("SELECT current_user")
    if cursor.fetchone()[0] == role:
        raise SystemExit(
            f"RUNTIME_DB_ROLE {role!r} is the DATABASE_URL login; the runtime role must be a separate role"
        )
    cursor.execute("SELECT rolsuper FROM pg_roles WHERE rolname = %s", (role,))
    existing = cursor.fetchone()
    if existing is not None and existing[0]:
        raise SystemExit(f"RUNTIME_DB_ROLE {role!r} is a superuser; refusing to repurpose it")
    verb = "ALTER" if existing is not None else "CREATE"
    cursor.execute(sql.SQL(verb + " ROLE {} WITH {}").format(ident, attributes))
    cursor.execute("SELECT current_database()")
    database = sql.Identifier(cursor.fetchone()[0])
    for statement in (
        "GRANT CONNECT ON DATABASE {database} TO {role}",
        "GRANT USAGE ON SCHEMA public TO {role}",
        "GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA public TO {role}",
        "GRANT USAGE ON ALL SEQUENCES IN SCHEMA public TO {role}",
        "ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO {role}",
        "ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT USAGE ON SEQUENCES TO {role}",
    ):
        cursor.execute(sql.SQL(statement).format(database=database, role=ident))
connection.close()
print(f"✅ Runtime role {role!r} {'updated' if verb == 'ALTER' else 'created'} (NOSUPERUSER/NOBYPASSRLS)")
PY
else
  echo "ℹ️  RUNTIME_DB_PASSWORD not set — runtime role is operator-managed, skipping."
fi
echo ""

echo "📋 Step 4/8: Database migrations"
echo "Running migrations..."
# Set QUICKSCALE_PRIVILEGED_COMMAND and clear RUNTIME_DATABASE_URL so
# migrations use the superuser DATABASE_URL (the runtime role has
# NOSUPERUSER/NOBYPASSRLS and cannot run DDL).
QUICKSCALE_PRIVILEGED_COMMAND=migrate RUNTIME_DATABASE_URL="" python manage.py migrate --noinput
echo "✅ Migrations completed successfully"
echo ""

echo "📋 Step 5/8: Cache table setup"
# Only needed for DatabaseCache — RedisCache is managed automatically.
# Set QUICKSCALE_PRIVILEGED_COMMAND and clear RUNTIME_DATABASE_URL so
# createcachetable uses the superuser DATABASE_URL (the runtime role has
# NOSUPERUSER/NOBYPASSRLS and cannot run DDL).
if [[ -z "${REDIS_URL:-}" ]]; then
    echo "REDIS_URL not set — creating database cache table via superuser DATABASE_URL..."
    QUICKSCALE_PRIVILEGED_COMMAND=createcachetable RUNTIME_DATABASE_URL="" python manage.py createcachetable
    echo "✅ Cache table ready"
else
    echo "REDIS_URL set — skipping database cache table (using Redis)"
fi
echo ""

echo "📋 Step 6/8: Superuser setup"
DJANGO_SUPERUSER_USERNAME="${DJANGO_SUPERUSER_USERNAME:-}"
DJANGO_SUPERUSER_EMAIL="${DJANGO_SUPERUSER_EMAIL:-}"
DJANGO_SUPERUSER_PASSWORD="${DJANGO_SUPERUSER_PASSWORD:-}"
if [[ -n "$DJANGO_SUPERUSER_USERNAME" && -n "$DJANGO_SUPERUSER_EMAIL" && -n "$DJANGO_SUPERUSER_PASSWORD" ]]; then
  echo "Attempting to create superuser '$DJANGO_SUPERUSER_USERNAME' (skipped if already exists)..."
  python manage.py shell -c "
import os
from django.contrib.auth import get_user_model
User = get_user_model()
username = os.environ['DJANGO_SUPERUSER_USERNAME']
if User.objects.filter(username=username).exists():
    print(f'Superuser {username!r} already exists, skipping.')
else:
    User.objects.create_superuser(username, os.environ['DJANGO_SUPERUSER_EMAIL'], os.environ['DJANGO_SUPERUSER_PASSWORD'])
    print(f'Superuser {username!r} created successfully.')
" || echo "⚠️  Superuser setup failed (non-fatal), continuing..."
else
  echo "ℹ️  DJANGO_SUPERUSER_* vars not set, skipping superuser creation."
fi
echo ""

echo "📋 Step 7/8: WSGI application check"
python -c "from {{ package_name }}.wsgi import application; print(f'✅ WSGI app loaded: {type(application).__name__}')"
echo ""

gunicorn_workers="${GUNICORN_WORKERS:-${WEB_CONCURRENCY:-1}}"

echo "📋 Step 8/8: Starting Gunicorn"
echo "Binding to 0.0.0.0:${PORT:-8000} with ${gunicorn_workers} workers"
echo "Gunicorn will log all requests below..."
echo "========================================"
echo ""

# Start Gunicorn with detailed logging
exec gunicorn {{ package_name }}.wsgi:application \
    --bind "0.0.0.0:${PORT:-8000}" \
  --workers "${gunicorn_workers}" \
    --timeout 60 \
    --log-level info \
    --access-logfile - \
    --error-logfile - \
    --capture-output \
    --enable-stdio-inheritance
