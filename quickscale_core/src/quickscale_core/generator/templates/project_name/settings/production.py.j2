# Trusted-proxy client-IP resolution (overrides base defaults)
#
# Production deployments typically sit behind a reverse proxy (e.g.
# Railway edge, Cloudflare).  Enable X-Forwarded-For resolution and
# declare the number of trusted proxies so that :func:`get_client_ip`
# and DRF throttles resolve the real client IP rather than the proxy's
# internal address.
#
# Single-host (no-proxy) deployments can disable both settings in their
# environment to keep ``REMOTE_ADDR`` behaviour.
USE_X_FORWARDED_FOR = config("USE_X_FORWARDED_FOR", default=True, cast=bool)
TRUSTED_PROXY_COUNT = config("TRUSTED_PROXY_COUNT", default=1, cast=int)


# Rebind client-IP resolution with production-aware globals so that
# :func:`get_client_ip` reads the overridden values of
# ``USE_X_FORWARDED_FOR`` and ``TRUSTED_PROXY_COUNT`` rather than the
# base defaults.
def get_client_ip(request: object) -> str:  # type: ignore[no-redef]
    """Return the canonical client IP address for *request*.

    See the base :func:`get_client_ip` docstring for full semantics.
    This rebind exists so that production defaults
    (``USE_X_FORWARDED_FOR=True``, ``TRUSTED_PROXY_COUNT=1``) are
    actually in effect at request time.
    """
    if not USE_X_FORWARDED_FOR or TRUSTED_PROXY_COUNT <= 0:
        return request.META.get("REMOTE_ADDR", "")  # type: ignore[attr-defined, no-any-return]

    x_forwarded_for: str = (
        request.META.get("HTTP_X_FORWARDED_FOR", "")  # type: ignore[attr-defined]
    ).strip()
    if not x_forwarded_for:
        return request.META.get("REMOTE_ADDR", "")  # type: ignore[attr-defined, no-any-return]

    ips = [ip.strip() for ip in x_forwarded_for.split(",") if ip.strip()]
    if len(ips) >= TRUSTED_PROXY_COUNT:
        return ips[-TRUSTED_PROXY_COUNT]  # type: ignore[no-any-return]
    # Chain shorter than the declared proxy count — fail closed to
    # REMOTE_ADDR instead of trusting a potentially spoofed leftmost
    # address.
    return request.META.get("REMOTE_ADDR", "")  # type: ignore[attr-defined, no-any-return]


# Recompute DRF proxy setting after the override so that
# ``NUM_PROXIES`` matches the production values of
# ``USE_X_FORWARDED_FOR`` and ``TRUSTED_PROXY_COUNT``.
REST_FRAMEWORK["NUM_PROXIES"] = TRUSTED_PROXY_COUNT if USE_X_FORWARDED_FOR else None  # noqa: F405


# Database - PostgreSQL for production
#
# Connection pooling: CONN_MAX_AGE=600 keeps persistent connections alive
# across requests, reducing per-request connection setup overhead.
# CONN_HEALTH_CHECKS=True validates connections before use, preventing
# errors from stale connections terminated by the database proxy or by a
# database or container restart.
#
# Runtime role pattern (fail-closed):
# ------------------------------------
# Runtime serving requires RUNTIME_DATABASE_URL (restricted
# NOSUPERUSER/NOBYPASSRLS role). When unset during serving, the app
# raises a clear error instead of silently falling back to the privileged
# superuser DATABASE_URL.
#
# Privileged DB commands (migrate, createcachetable) are launched by
# start.sh with QUICKSCALE_PRIVILEGED_COMMAND and RUNTIME_DATABASE_URL=""
# so the superuser DATABASE_URL is used instead (schema changes require
# elevated privileges).
#
# Non-DB bootstrap commands (collectstatic, compilemessages) are launched
# with QUICKSCALE_NON_DB_COMMAND when the database is not needed.
#
# The explicit dev/test opt-out is QUICKSCALE_ALLOW_BYPASSRLS=1 with
# RUNTIME_DATABASE_URL="" to bridge to DATABASE_URL.
_runtime_db_url = config("RUNTIME_DATABASE_URL", default=None)
database_url = config("DATABASE_URL", default=None)
_privileged_command = os.environ.get("QUICKSCALE_PRIVILEGED_COMMAND", "")
_non_db_command = os.environ.get("QUICKSCALE_NON_DB_COMMAND", "")

_KNOWN_PRIVILEGED_COMMANDS = frozenset({"migrate", "createcachetable"})
_KNOWN_NON_DB_COMMANDS = frozenset({"collectstatic", "compilemessages"})

# Mutual exclusivity: cannot set both command-mode vars simultaneously.
if _privileged_command and _non_db_command:
    raise ValueError(
        "Both QUICKSCALE_PRIVILEGED_COMMAND and QUICKSCALE_NON_DB_COMMAND "
        "are set. These modes are mutually exclusive. "
        "Set only one command-mode variable at a time."
    )

if _privileged_command:
    # Privileged DB command: validate and require superuser DATABASE_URL
    if _privileged_command not in _KNOWN_PRIVILEGED_COMMANDS:
        raise ValueError(
            f"Unknown QUICKSCALE_PRIVILEGED_COMMAND value {_privileged_command!r}. "
            f"Supported values: {', '.join(sorted(_KNOWN_PRIVILEGED_COMMANDS))}."
        )
    if _runtime_db_url is None or _runtime_db_url != "":
        raise ValueError(
            "RUNTIME_DATABASE_URL must be explicitly blank when "
            "QUICKSCALE_PRIVILEGED_COMMAND is set. "
            'Set RUNTIME_DATABASE_URL="" alongside the privileged command.'
        )
    if not database_url:
        raise ValueError(
            "DATABASE_URL is required for privileged database commands. "
            "Set DATABASE_URL to the superuser connection string."
        )
    _db_url = database_url
elif _non_db_command:
    # Non-DB bootstrap command: validate, provide dummy URL if needed
    if _non_db_command not in _KNOWN_NON_DB_COMMANDS:
        raise ValueError(
            f"Unknown QUICKSCALE_NON_DB_COMMAND value {_non_db_command!r}. "
            f"Supported values: {', '.join(sorted(_KNOWN_NON_DB_COMMANDS))}."
        )
    _db_url = database_url or "postgresql://dummy:dummy@localhost:5432/dummy"
elif _runtime_db_url:
    _db_url = _runtime_db_url
elif _runtime_db_url == "" and os.environ.get("QUICKSCALE_ALLOW_BYPASSRLS") == "1":
    # Explicit dev/test opt-out: bridge to DATABASE_URL
    if not database_url:
        raise ValueError(
            "DATABASE_URL environment variable is not set or is empty. "
            "QUICKSCALE_ALLOW_BYPASSRLS=1 requires the superuser "
            "DATABASE_URL for privileged operations. "
            "Ensure the database service is linked to your app service."
        )
    _db_url = database_url
else:
    # Runtime serving: fail closed — RUNTIME_DATABASE_URL is required
    raise ValueError(
        "RUNTIME_DATABASE_URL is required for runtime serving. "
        "The restricted NOSUPERUSER/NOBYPASSRLS database role connection "
        "string must be provided when serving requests. "
        "Set RUNTIME_DATABASE_URL in your environment to the runtime role's "
        "PostgreSQL connection string. "
        "For privileged commands, the deployment script (start.sh) "
        "automatically sets QUICKSCALE_PRIVILEGED_COMMAND and clears "
        "RUNTIME_DATABASE_URL so the superuser DATABASE_URL is used instead."
    )

DATABASES = {
    "default": cast(
        dict[str, object],
        dj_database_url.parse(
            _db_url,
            conn_max_age=600,
            conn_health_checks=True,
        ),
    )
}

