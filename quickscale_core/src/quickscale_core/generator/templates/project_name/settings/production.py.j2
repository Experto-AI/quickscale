# Trusted-proxy client-IP resolution (overrides base defaults)
#
# Production deployments typically sit behind a reverse proxy (e.g.
# Railway edge, Cloudflare).  Enable X-Forwarded-For resolution and
# declare the number of trusted proxies so that :func:`get_client_ip`
# and DRF throttles resolve the real client IP rather than the proxy's
# internal address.
#
# Single-host (no-proxy) deployments can disable both settings in their
# environment to keep ``REMOTE_ADDR`` behaviour.
USE_X_FORWARDED_FOR = config("USE_X_FORWARDED_FOR", default=True, cast=bool)
TRUSTED_PROXY_COUNT = config("TRUSTED_PROXY_COUNT", default=1, cast=int)


# Rebind client-IP resolution with production-aware globals so that
# :func:`get_client_ip` reads the overridden values of
# ``USE_X_FORWARDED_FOR`` and ``TRUSTED_PROXY_COUNT`` rather than the
# base defaults.
def get_client_ip(request: object) -> str:
    """Return the canonical client IP address for *request*.

    See the base :func:`get_client_ip` docstring for full semantics.
    This rebind exists so that production defaults
    (``USE_X_FORWARDED_FOR=True``, ``TRUSTED_PROXY_COUNT=1``) are
    actually in effect at request time.
    """
    if not USE_X_FORWARDED_FOR or TRUSTED_PROXY_COUNT <= 0:
        return request.META.get("REMOTE_ADDR", "")  # type: ignore[union-attr]

    x_forwarded_for: str = (
        request.META.get("HTTP_X_FORWARDED_FOR", "")  # type: ignore[union-attr]
    ).strip()
    if not x_forwarded_for:
        return request.META.get("REMOTE_ADDR", "")  # type: ignore[union-attr]

    ips = [ip.strip() for ip in x_forwarded_for.split(",") if ip.strip()]
    if len(ips) >= TRUSTED_PROXY_COUNT:
        return ips[-TRUSTED_PROXY_COUNT]
    # Chain shorter than the declared proxy count — fail closed to
    # REMOTE_ADDR instead of trusting a potentially spoofed leftmost
    # address.
    return request.META.get("REMOTE_ADDR", "")  # type: ignore[union-attr]


# Recompute DRF proxy setting after the override so that
# ``NUM_PROXIES`` matches the production values of
# ``USE_X_FORWARDED_FOR`` and ``TRUSTED_PROXY_COUNT``.
REST_FRAMEWORK["NUM_PROXIES"] = TRUSTED_PROXY_COUNT if USE_X_FORWARDED_FOR else None  # noqa: F405


# Database - PostgreSQL for production
#
# Connection pooling: CONN_MAX_AGE=600 keeps persistent connections alive
# across requests, reducing per-request connection setup overhead.
# CONN_HEALTH_CHECKS=True validates connections before use, preventing
# errors from stale connections terminated by the database proxy or by a
# database or container restart.
#
# Runtime role pattern (fail-closed):
# ------------------------------------
# Runtime serving requires RUNTIME_DATABASE_URL (restricted
# NOSUPERUSER/NOBYPASSRLS role). When unset during serving, the app
# raises a clear error instead of silently falling back to the privileged
# superuser DATABASE_URL.
#
# The migration path is the named exception: start.sh unsets
# RUNTIME_DATABASE_URL during migrations so the superuser DATABASE_URL
# is used instead (schema changes require elevated privileges).
# collectstatic and compilemessages also bypass the check.
_runtime_db_url = config("RUNTIME_DATABASE_URL", default=None)
database_url = config("DATABASE_URL", default=None)

if _runtime_db_url:
    _db_url = _runtime_db_url
elif "migrate" in sys.argv:
    # Migration path: require the superuser DATABASE_URL
    if not database_url:
        raise ValueError(
            "DATABASE_URL environment variable is not set or is empty. "
            "Migrations require the superuser database connection. "
            "Railway requires DATABASE_URL to connect to PostgreSQL. "
            "Ensure the database service is linked to your app service in Railway dashboard."
        )
    _db_url = database_url
elif "collectstatic" in sys.argv or "compilemessages" in sys.argv:
    # Non-DB commands: provide a dummy URL so Django can configure itself
    _db_url = database_url or "postgresql://dummy:dummy@localhost:5432/dummy"
else:
    # Runtime serving: fail closed — RUNTIME_DATABASE_URL is required
    raise ValueError(
        "RUNTIME_DATABASE_URL is required for runtime serving. "
        "The restricted NOSUPERUSER/NOBYPASSRLS database role connection "
        "string must be provided when serving requests. "
        "Set RUNTIME_DATABASE_URL in your environment to the runtime role's "
        "PostgreSQL connection string. "
        "For migrations, the deployment script (start.sh) automatically "
        "unsets this variable so the superuser DATABASE_URL is used instead."
    )

DATABASES = {
    "default": cast(
        dict[str, object],
        dj_database_url.parse(
            _db_url,
            conn_max_age=600,
            conn_health_checks=True,
        ),
    )
}

