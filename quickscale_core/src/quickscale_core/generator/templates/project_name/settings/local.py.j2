# Browser-facing Vite port. Docker/E2E can remap the host publication while
# Vite continues to listen on its container-internal port.
def _quickscale_validate_frontend_host_port(configured_port: str) -> int:
    if re.fullmatch(r"[1-9][0-9]{0,4}", configured_port) is None:
        raise ValueError("QUICKSCALE_FRONTEND_HOST_PORT must be between 1 and 65535")
    host_port = int(configured_port)
    if host_port > 65535:
        raise ValueError("QUICKSCALE_FRONTEND_HOST_PORT must be between 1 and 65535")
    return host_port


QUICKSCALE_FRONTEND_HOST_PORT = _quickscale_validate_frontend_host_port(
    config(
        "QUICKSCALE_FRONTEND_HOST_PORT",
        default="5173",
    )
)


# Full browser-visible Vite origin. Override this for remote development or an
# HTTPS tunnel; an empty value keeps the localhost origin derived from the
# published host port above.
def _quickscale_canonical_frontend_hostname(hostname: str) -> str | None:
    try:
        hostname.encode("ascii")
    except UnicodeEncodeError:
        return None
    if "%" in hostname:
        return None

    try:
        address = ip_address(hostname)
    except ValueError:
        last_label = hostname.rsplit(".", maxsplit=1)[-1]
        if re.fullmatch(r"(?:0[xX][0-9a-fA-F]+|[0-9]+)", last_label):
            return None
        labels = hostname.split(".")
        if not all(
            re.fullmatch(r"[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?", label) for label in labels
        ):
            return None
        return hostname

    canonical_address = address.compressed
    if hostname.lower() != canonical_address:
        return None
    if address.version == 6:
        return f"[{canonical_address}]"
    return canonical_address


def _quickscale_validate_frontend_origin(configured_origin: str) -> str:
    try:
        origin = urlsplit(configured_origin)
        origin_port = origin.port
    except ValueError as error:
        raise ValueError("QUICKSCALE_FRONTEND_ORIGIN must be a canonical HTTP(S) origin") from error

    hostname = origin.hostname
    if (
        origin.scheme not in {"http", "https"}
        or hostname is None
        or origin.username is not None
        or origin.password is not None
        or origin.path not in {"", "/"}
        or origin.query
        or origin.fragment
        or origin_port == 0
    ):
        raise ValueError("QUICKSCALE_FRONTEND_ORIGIN must be a canonical HTTP(S) origin")

    normalized_hostname = _quickscale_canonical_frontend_hostname(hostname)
    if normalized_hostname is None:
        raise ValueError("QUICKSCALE_FRONTEND_ORIGIN must be a canonical HTTP(S) origin")
    default_port = 80 if origin.scheme == "http" else 443
    normalized_port = "" if origin_port in {None, default_port} else f":{origin_port}"
    canonical_origin = f"{origin.scheme}://{normalized_hostname}{normalized_port}"
    if configured_origin not in {canonical_origin, f"{canonical_origin}/"}:
        raise ValueError("QUICKSCALE_FRONTEND_ORIGIN must be a canonical HTTP(S) origin")

    return canonical_origin


_quickscale_frontend_origin = config("QUICKSCALE_FRONTEND_ORIGIN", default="").strip()
QUICKSCALE_FRONTEND_ORIGIN = (
    _quickscale_validate_frontend_origin(_quickscale_frontend_origin)
    if _quickscale_frontend_origin
    else f"http://localhost:{QUICKSCALE_FRONTEND_HOST_PORT}"
)

# Allow all hosts in development (including Docker containers running on 0.0.0.0)
ALLOWED_HOSTS = ["localhost", "127.0.0.1", "[::1]", "0.0.0.0", "*"]

# Database - PostgreSQL required for local development
#
# Docker Compose sets both DATABASE_URL (superuser) and
# RUNTIME_DATABASE_URL (restricted NOSUPERUSER role).  For normal
# serving the restricted role is preferred, but during migrations
# the superuser URL must be used so that DDL (CREATE TABLE etc.)
# is allowed on the public schema.
#
# When neither is set the app raises a clear error.
_runtime_db_url = config("RUNTIME_DATABASE_URL", default=None)
_database_url = config("DATABASE_URL", default=None)

if _runtime_db_url:
    _db_url = _runtime_db_url
elif _database_url:
    _db_url = _database_url
else:
    raise ValueError(
        "DATABASE_URL (or RUNTIME_DATABASE_URL) is required in local settings. "
        "Set DATABASE_URL in your .env file before running manage.py commands."
    )

DATABASES: dict[str, Any] = {  # type: ignore[no-redef]  # noqa: F405
    "default": dj_database_url.parse(
        _db_url,
        conn_max_age=0,
        ssl_require=False,
    )
}

