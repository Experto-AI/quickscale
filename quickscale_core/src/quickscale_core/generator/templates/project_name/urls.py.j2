import importlib
from typing import Any, cast

from django.conf import settings
from django.conf.urls.static import static
from django.contrib import admin
from django.db import Error as DatabaseError
from django.db import connections
from django.db.migrations.executor import MigrationExecutor
from django.http import HttpRequest, HttpResponse
from django.urls import include, path, re_path

from {{ package_name }}.views import react_shell_view


def healthcheck(request: HttpRequest) -> HttpResponse:
    """Liveness endpoint for Railway and other monitoring services.

    Returns HTTP 200 OK without requiring database access or HTTPS redirect.
    This endpoint is exempt from SECURE_SSL_REDIRECT in production settings.
    """
    return HttpResponse("OK", content_type="text/plain", status=200)


def readiness(request: HttpRequest) -> HttpResponse:
    """Readiness endpoint for Railway and other deployment gates.

    Returns HTTP 200 only while the database is reachable and every migration
    is applied. Returns HTTP 503 otherwise, so a deployment whose pre-deploy
    ``./predeploy.sh`` step was skipped or failed is never promoted to serve
    traffic against an outdated schema. This endpoint is exempt from
    SECURE_SSL_REDIRECT in production settings.
    """
    try:
        connection = connections["default"]
        connection.ensure_connection()
        executor = MigrationExecutor(connection)
        pending_plan = executor.migration_plan(executor.loader.graph.leaf_nodes())
    except DatabaseError:
        return HttpResponse("NOT READY", content_type="text/plain", status=503)
    if pending_plan:
        return HttpResponse("NOT READY", content_type="text/plain", status=503)
    return HttpResponse("OK", content_type="text/plain", status=200)


urlpatterns = [
    path("healthcheck/", healthcheck, name="healthcheck"),
    path("ready/", readiness, name="readiness"),
    path("admin/", admin.site.urls),
    # The managed URLconf holds every module-facing route and include: the
    # theme's shell routes and each installed and enabled module's URLs and
    # manifest-declared React shell routes.  apply regenerates it from the
    # embedded module manifests; this file names no module.
    path("", include("{{ package_name }}.urls_modules")),
]

# Custom error handlers with helpful module guidance
handler404 = "{{ package_name }}.views.custom_404_view"
handler500 = "{{ package_name }}.views.custom_500_view"

# Serve media files in development
if settings.DEBUG:  # pragma: no cover - dev-only media/debug-toolbar branch
    urlpatterns += static(settings.MEDIA_URL, document_root=settings.MEDIA_ROOT)

    # Django Debug Toolbar (if installed)
    try:
        debug_toolbar_urls = cast(
            Any,
            importlib.import_module("debug_toolbar"),
        ).urls
        urlpatterns = [
            path("__debug__/", include(debug_toolbar_urls)),
        ] + urlpatterns
    except ImportError:
        pass

# React SPA catch-all: serve index.html for client-side routing.
# This must be enabled in both local and production environments so
# direct navigation to routes like /settings works on Railway.
urlpatterns += [
    re_path(r".*", react_shell_view),
]
