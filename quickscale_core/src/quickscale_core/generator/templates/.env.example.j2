# Django Core Settings
# SECURITY WARNING: the shipped SECRET_KEY placeholder is for local development only.
# Production settings reject blank or default SECRET_KEY values.
# Generate a new secret key for production: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=django-insecure-change-this-in-production

# SECURITY WARNING: don't run with debug turned on in production!
DEBUG=True

# Comma-separated list of allowed hosts (includes Docker bridge interfaces)
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Docker User Mapping
# Prevents Docker containers from creating root-owned files in mounted volumes
# These are set automatically during project generation (in .env)
# Adjust if your host user has a different UID/GID
DOCKER_UID=1000
DOCKER_GID=1000

# Server Configuration
# Port for Django development server and Docker containers
PORT=8000

# Database Configuration
# Format: postgresql://user:password@host:port/dbname
# For local development with docker compose, use:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/{{ package_name }}

# Runtime database role (RLS enforcement, required for production)
# NOSUPERUSER/NOBYPASSRLS role for normal application queries.
# When set, the app uses this for the default database connection instead of
# DATABASE_URL. During runtime serving, this URL is required (the app raises
# a clear error if unset). During migrations, the startup script (start.sh)
# unsets RUNTIME_DATABASE_URL so the superuser DATABASE_URL is used instead.
# For non-Docker local development: remove this line from your .env so that
# local.py uses DATABASE_URL directly (the runtime role is provisioned
# automatically by Docker Compose, not by a plain local setup).
# See OPERATIONS.md for manual setup instructions.
RUNTIME_DATABASE_URL=postgresql://{{ runtime_db_role }}:{{ runtime_db_password }}@localhost:5432/{{ package_name }}

# Email Configuration (optional)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@example.com
# EMAIL_HOST_PASSWORD=your-app-password

# QuickScale Notifications (managed)
# Leave these blank until your verified Resend domain is ready for live delivery.
RESEND_API_KEY=
QUICKSCALE_NOTIFICATIONS_WEBHOOK_SECRET=
# End QuickScale Notifications

# Static and Media Files
# STATIC_URL=/static/
# STATIC_ROOT=staticfiles
# MEDIA_URL=/media/
# MEDIA_ROOT=media

# Application Settings
# Add your custom application settings here
# ENABLE_FEATURE_X=True
# API_KEY=your-api-key-here
