services:
  db:
    image: postgres:{{ postgres_docker_tag }}
    container_name: "${QUICKSCALE_RESOURCE_PREFIX:-{{ project_name }}}_db"
    labels:
      com.quickscale.owner: "quickscale"
      com.quickscale.lifecycle: "e2e"
      com.quickscale.scope: "${QUICKSCALE_RESOURCE_PREFIX:-{{ project_name }}}"
    environment:
      POSTGRES_DB: {{ package_name }}
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
    volumes:
      - postgres_data:/var/lib/postgresql
      - ./db/init.sql:/docker-entrypoint-initdb.d/init.sql
    # Port mapping removed to avoid conflicts with system PostgreSQL
    # The backend service can still access the database via the internal Docker network
    # If you need to access PostgreSQL from your host, uncomment the next 2 lines:
    # ports:
    #   - "5433:5432"  # Maps to host port 5433 to avoid conflict with system PostgreSQL
    healthcheck:
      test: ["CMD-SHELL", "psql -v ON_ERROR_STOP=1 -U postgres -d {{ package_name }} -Atqc \"SELECT 1 WHERE current_setting('quickscale.init_complete', true) = 'true'\" | grep -qx 1"]
      interval: 10s
      timeout: 5s
      retries: 5

{% if theme == 'showcase_react' %}
  frontend:
    image: node:24-slim
    container_name: "${QUICKSCALE_RESOURCE_PREFIX:-{{ project_name }}}_frontend"
    labels:
      com.quickscale.owner: "quickscale"
      com.quickscale.lifecycle: "e2e"
      com.quickscale.scope: "${QUICKSCALE_RESOURCE_PREFIX:-{{ project_name }}}"
    # Map to host user to prevent root-owned files in mounted volumes
    user: "${DOCKER_UID:-1000}:${DOCKER_GID:-1000}"
    working_dir: /app/frontend
    environment:
      - HOME=/tmp
      - QUICKSCALE_FRONTEND_HOST_PORT=${QUICKSCALE_FRONTEND_HOST_PORT:-5173}
      - QUICKSCALE_FRONTEND_ORIGIN=${QUICKSCALE_FRONTEND_ORIGIN:-}
    # Use corepack without `enable` because this container runs as non-root.
    # `corepack enable` writes to /usr/local/bin and fails with EACCES.
    #
    # Raise pnpm's fetch retry budget for the same network resilience the
    # Dockerfile's frontend-builder stage documents: a single stalled registry
    # request otherwise aborts the entire install, leaving `quickscale up`
    # with a failed-to-start frontend on constrained links.
    command: sh -c "corepack pnpm install --no-frozen-lockfile --config.fetch-retries=5 && corepack pnpm run build && corepack pnpm run dev --host 0.0.0.0"
    volumes:
      - .:/app
    ports:
      # Test lanes override only the host publication to avoid cross-run collisions.
      - "${QUICKSCALE_FRONTEND_HOST_PORT:-5173}:5173"
    healthcheck:
      test: ["CMD-SHELL", "node -e \"const {request}=require('node:http');const port=process.env.QUICKSCALE_FRONTEND_HOST_PORT||'5173';const host=new URL(process.env.QUICKSCALE_FRONTEND_ORIGIN||('http://localhost:'+port)).host;const probe=request({hostname:'127.0.0.1',port:5173,path:'/static/frontend/src/index.css',headers:{Host:host}},response=>process.exit(response.statusCode===200?0:1));probe.on('error',()=>process.exit(1));probe.end()\""]
      interval: 5s
      timeout: 3s
      # Cold dependency downloads can exceed two minutes on constrained links.
      retries: 120
      start_period: 10s
{% endif %}

  backend:
    image: "${QUICKSCALE_BACKEND_IMAGE:-quickscale-backend:{{ project_name }}}"
    build:
      context: .
      dockerfile: Dockerfile
      args:
        INSTALL_DEV: "true"  # Install dev dependencies for local development
        QUICKSCALE_BACKEND_IMAGE_DIGEST: "${QUICKSCALE_BACKEND_IMAGE_DIGEST:-direct-compose}"
        QUICKSCALE_IMAGE_CONTRACT: "sa142"
    container_name: "${QUICKSCALE_RESOURCE_PREFIX:-{{ project_name }}}_backend"
    labels:
      com.quickscale.owner: "quickscale"
      com.quickscale.lifecycle: "e2e"
      com.quickscale.scope: "${QUICKSCALE_RESOURCE_PREFIX:-{{ project_name }}}"
    command: python manage.py runserver 0.0.0.0:${PORT:-8000}
    # Map to host user to prevent root-owned files in mounted volumes
    user: "${DOCKER_UID:-1000}:${DOCKER_GID:-1000}"
    volumes:
      - .:/app
      - static_volume:/app/staticfiles
      - media_volume:/app/media
    ports:
      - "${PORT:-8000}:${PORT:-8000}"
    # Load the project's .env into the container so a credential under any
    # configured *_env_var name reaches it; the environment entries below keep
    # the default names available from a shell export and take precedence over
    # env_file.  A blank value keeps an enabled module's startup check failing
    # on purpose until the operator supplies the credential.
    env_file:
      - .env
    environment:
      - DJANGO_SETTINGS_MODULE={{ package_name }}.settings.local
      - DATABASE_URL=postgresql://postgres:postgres@db:5432/{{ package_name }}
      - RUNTIME_DATABASE_URL=postgresql://{{ runtime_db_role }}:{{ runtime_db_password }}@db:5432/{{ package_name }}
      - PORT=${PORT:-8000}
      - QUICKSCALE_FRONTEND_HOST_PORT=${QUICKSCALE_FRONTEND_HOST_PORT:-5173}
      - QUICKSCALE_FRONTEND_ORIGIN=${QUICKSCALE_FRONTEND_ORIGIN:-}
      - STRIPE_PUBLISHABLE_KEY=${STRIPE_PUBLISHABLE_KEY:-}
      - STRIPE_SECRET_KEY=${STRIPE_SECRET_KEY:-}
      - QUICKSCALE_BILLING_WEBHOOK_SECRET=${QUICKSCALE_BILLING_WEBHOOK_SECRET:-}
      - RESEND_API_KEY=${RESEND_API_KEY:-}
      - QUICKSCALE_NOTIFICATIONS_WEBHOOK_SECRET=${QUICKSCALE_NOTIFICATIONS_WEBHOOK_SECRET:-}
      - POSTHOG_API_KEY=${POSTHOG_API_KEY:-}
      - AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID:-}
      - AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY:-}
      - QUICKSCALE_BACKUPS_REMOTE_ACCESS_KEY_ID=${QUICKSCALE_BACKUPS_REMOTE_ACCESS_KEY_ID:-}
      - QUICKSCALE_BACKUPS_REMOTE_SECRET_ACCESS_KEY=${QUICKSCALE_BACKUPS_REMOTE_SECRET_ACCESS_KEY:-}
    depends_on:
      db:
        condition: service_healthy
{% if theme == 'showcase_react' %}
      frontend:
        condition: service_healthy
{% endif %}

volumes:
  postgres_data:
    labels:
      com.quickscale.owner: "quickscale"
      com.quickscale.lifecycle: "e2e"
      com.quickscale.scope: "${QUICKSCALE_RESOURCE_PREFIX:-{{ project_name }}}"
  static_volume:
    labels:
      com.quickscale.owner: "quickscale"
      com.quickscale.lifecycle: "e2e"
      com.quickscale.scope: "${QUICKSCALE_RESOURCE_PREFIX:-{{ project_name }}}"
  media_volume:
    labels:
      com.quickscale.owner: "quickscale"
      com.quickscale.lifecycle: "e2e"
      com.quickscale.scope: "${QUICKSCALE_RESOURCE_PREFIX:-{{ project_name }}}"

networks:
  default:
    labels:
      com.quickscale.owner: "quickscale"
      com.quickscale.lifecycle: "e2e"
      com.quickscale.scope: "${QUICKSCALE_RESOURCE_PREFIX:-{{ project_name }}}"
