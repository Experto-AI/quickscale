                "order": 8,
                "display_name": "Project Contract Vintage Gate (SA207)",
                "check_step_name": "Verify generated-template and module-manifest contract changes declare a new step id",
                "full_history": true
            },
            "publish": {
                "order": 6,
                "step_name": "Run project contract vintage gate",
                "command_prefix": "PROJECT_VINTAGE_BASE_REF=\"$(git describe --tags --abbrev=0 'HEAD^' 2>/dev/null || git rev-list --max-parents=0 HEAD | tail -n 1)\""
            },
            "help": "Inspect every non-merge commit in the selected base-to-head range.  A change\nto any template the generator emits (the watched set derives from the\ngenerator's emission mapping), a generator change that alters the emitted\nfile set, or a module manifest step whose text changes without a new id\nrequires a fresh adoption step id in the same commit (the project\ndeclaration or the module manifest), so a generated-project contract change\ncannot ship without its adoption steps.",
            "local": {
                "order": 8,
                "description": "Running project contract vintage gate...",
                "success": "\u2713 Generated-project contract changes declare an adoption step id",
                "failure_label": "Project Contract Vintage Gate"
            },
            "makefile_help": {
                "order": 7,
                "text": "make check-project-contract-vintage - Generated-project contract changes declare a fresh adoption step id"
