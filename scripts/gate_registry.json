{
    "schema_version": 1,
    "description": "QuickScale gate registry \u2014 declares every gating checkpoint across all execution contexts (local serial/parallel, hosted CI, publish, e2e-trigger). The legacy trigger_inputs field is the ordered, bidirectional partition of e2e.yml's pull-request path allowlist; it never controls whether a gate runs. Any future skip based on trigger_inputs promotes the field for rename or redesign. Source of truth for gate-parity diagnostics.",
    "contexts": {
        "local-serial": "scripts/check_ci_locally.sh serial mode (QS_CI_PARALLEL=0)",
        "local-parallel": "scripts/check_ci_locally.sh parallel mode (default)",
        "hosted": ".github/workflows/ci.yml hosted CI",
        "publish": ".github/workflows/publish.yml release workflow",
        "e2e-trigger": ".github/workflows/e2e.yml ordered path allowlist"
    },
    "gates": [
        {
            "id": "check-core-compat",
            "description": "Module quickscale_core imports resolve against current core API, and the quickscale-core lockstep pin matches VERSION",
            "required_contexts": [
                "local-serial",
                "local-parallel",
                "hosted",
                "publish",
                "e2e-trigger"
            ],
            "bindings": {
                "make_target": "check-core-compat",
                "ci_job": "module-core-compat",
                "local_ci_stage": 3
            },
            "hosted": {
                "order": 1,
                "display_name": "Module-vs-Oldest-Core Compatibility",
                "check_step_name": "Run module-vs-core compatibility check (static analysis + install/import probe)"
            },
            "publish": {
                "order": 1,
                "step_name": "Run core compatibility gate"
            },
            "help": "Check each module's quickscale_core imports against the current core API.\nThis verifies that every import from quickscale_core in a module's source\nresolves to an existing symbol, and that the module's quickscale-core\nspecifier is exactly the lockstep pin derived from VERSION.",
            "local": {
                "order": 1,
                "description": "Running module-vs-core compatibility check...",
                "success": "\u2713 Module-to-core compatibility passed",
                "failure_label": "Module-Core Compatibility"
            },
            "makefile_help": {
                "order": 1,
                "text": "make check-core-compat            - Module core imports resolve, and the lockstep pin matches VERSION"
            },
            "make_recipe": [
                "@$(PYTHON) scripts/check_module_core_compatibility.py"
            ],
            "depends_on": [],
            "trigger_inputs": [
                "quickscale_modules/backups/**"
            ]
        },
        {
            "id": "check-module-core-imports",
            "description": "Module code imports only from quickscale_core.runtime",
            "required_contexts": [
                "local-serial",
                "local-parallel",
                "hosted",
                "publish",
                "e2e-trigger"
